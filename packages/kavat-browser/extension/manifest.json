{
  "manifest_version": 3,
  "name": "Kavat",
  "version": "0.1.0",
  "description": "What makes the browser a piece of Willwitcher-OS Kavat Edition: the command console, the start page, clippings and albums in the notes, and the system's modes.",
  "key": "",
  "permissions": ["tabs", "nativeMessaging", "storage", "scripting", "activeTab", "contextMenus", "downloads", "bookmarks", "topSites", "search", "favicon", "sidePanel"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Kavat: the command console", "default_popup": "popup.html" },
  "chrome_url_overrides": { "newtab": "start.html" },
  "side_panel": { "default_path": "panel.html" },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Ctrl+Shift+K" },
      "description": "Open the command console"
    },
    "clip-page": {
      "suggested_key": { "default": "Ctrl+Shift+S" },
      "description": "Save the page to the notes, with what is selected as a quote"
    },
    "read-later": {
      "suggested_key": { "default": "Ctrl+Shift+L" },
      "description": "Keep the page in the album of what waits to be read"
    },
    "zen": {
      "suggested_key": { "default": "Ctrl+Shift+Z" },
      "description": "Zen mode: the page and nothing else"
    }
  },
  "icons": { "48": "icon.png", "128": "icon.png" }
}
