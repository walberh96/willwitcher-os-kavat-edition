#!/usr/bin/env python3
"""The browser's line to the system: the program the Kavat extension talks to.

The browser starts it when the extension asks for it, and they speak in messages: four
bytes with the length, then that much JSON. The extension asks for the system theme's
colours, the mode in force, your own commands of the console, a clipping to be saved to
the notes, the albums of sites and the notes there are about a site, or a folder to be
opened in Yazi, and tells which tabs are open, which this keeps for the launcher of the
desktop. The other way, this tells the extension when
the system's mode changes, and passes on a command the system asks the browser for:
`kavat-browser command "<name>"` leaves it in a folder this watches.

Nothing here is reachable from a web page: only the Kavat extension may start it.
"""
import base64
import json
import os
import re
import select
import struct
import subprocess
import sys
import tempfile
import time
import tomllib

HOME = os.path.expanduser('~')
CONFIG = os.environ.get('XDG_CONFIG_HOME') or f'{HOME}/.config'
STATE = os.environ.get('XDG_STATE_HOME') or f'{HOME}/.local/state'
RUNTIME = os.environ.get('XDG_RUNTIME_DIR') or f'/run/user/{os.getuid()}'
COMMANDS = f'{CONFIG}/kavat/browser/commands.toml'
SETTINGS = f'{CONFIG}/kavat/browser/browser.toml'
NOTES = os.path.realpath(f'{HOME}/Notes')
MODE = f'{STATE}/kavat/mode.json'
ASKED = f'{RUNTIME}/kavat-browser'  # commands the system asks for, one file each
TABS = f'{ASKED}/tabs'  # the tabs that are open, one file for each host: a profile has its own
TOKENS = {'bg': 'bg', 'surface': 'surface', 'surface2': 'surface2', 'text': 'text', 'muted': 'muted',
          'border': 'border', 'accent': 'accent', 'on_accent': 'on_accent'}


def read_message():
    head = sys.stdin.buffer.read(4)
    if len(head) < 4:
        return None
    length = struct.unpack('=I', head)[0]
    if length > 8 << 20:  # a clipping carries a picture of the page, of the whole of it at most
        return None
    try:
        return json.loads(sys.stdin.buffer.read(length))
    except ValueError:
        return {}


def write_message(message):
    data = json.dumps(message).encode()
    sys.stdout.buffer.write(struct.pack('=I', len(data)) + data)
    sys.stdout.buffer.flush()


def out(*command, timeout=15, given=None):
    try:
        done = subprocess.run(command, capture_output=True, text=True, timeout=timeout, check=False,
                              **({'input': given} if given is not None else {'stdin': subprocess.DEVNULL}))
    except (OSError, subprocess.TimeoutExpired):
        return None
    return done.stdout.strip() if done.returncode == 0 else None


def mode():
    try:
        with open(MODE, encoding='utf-8') as file:
            return json.load(file).get('mode', 'coder')
    except (OSError, ValueError):
        return 'coder'


def theme():
    """The colours in force, as kavat-theme says them: a name and its value, one to a line."""
    found = {}
    for line in (out('kavat-theme', 'tokens') or '').splitlines():
        name, _, value = line.partition(' ')
        found[name] = value.strip()
    wear = {ours: found[token] for ours, token in TOKENS.items() if token in found}
    for name in ('radius', 'mode'):
        if name in found:
            wear[name] = found[name]
    return wear


def commands():
    try:
        with open(COMMANDS, 'rb') as file:
            listed = tomllib.load(file).get('command', [])
    except (OSError, tomllib.TOMLDecodeError):
        return []
    return [{key: str(value) for key, value in one.items() if key in ('name', 'about', 'run', 'given', 'open')}
            for one in listed if isinstance(one, dict)]


def settings():
    """What the browser is set to in its file: the album of the start page, and what the
    start page shows behind it, with a mark that changes when that picture does."""
    try:
        with open(SETTINGS, 'rb') as file:
            found = tomllib.load(file)
    except (OSError, tomllib.TOMLDecodeError):
        found = {}
    kept = {'start_album': str(found.get('start_album') or ''), 'start_background': str(found.get('start_background') or 'theme')}
    source = background_source(kept['start_background'])
    kept['start_background_stamp'] = f'{source}:{os.path.getmtime(source)}' if source else ''
    return kept


def set_line(key, value):
    """Write one setting in the settings file: that one line, and nothing else of it."""
    try:
        with open(SETTINGS, encoding='utf-8') as file:
            text = file.read()
    except OSError:
        text = ''
    line = f'{key} = {json.dumps(value)}'
    text, changed = re.subn(rf'^#?\s*{key}\s*=.*$', lambda _: line, text, count=1, flags=re.M)
    if not changed:
        # before any table of the file, where a line of its own belongs
        text = line + '\n' + text
    os.makedirs(os.path.dirname(SETTINGS), exist_ok=True)
    with open(SETTINGS, 'w', encoding='utf-8') as file:
        file.write(text)
    return {'settings': settings()}


def set_start_album(message):
    return set_line('start_album', re.sub(r'[^A-Za-z0-9 _-]', '', str(message.get('name') or '')).strip()[:60])


# ---- what the start page shows behind it

OWN_BACKGROUND = f'{CONFIG}/kavat/browser/start-background.jpg'
CACHE = (os.environ.get('XDG_CACHE_HOME') or f'{HOME}/.cache') + '/kavat/browser'


def background_source(choice):
    """The file the start page's background is made from; None for the theme's own colour."""
    if choice == 'wallpaper':
        # the desktop's background, as kavat-wallpaper names it: its kind, then its file
        said = (out('kavat-wallpaper') or '').strip().split(' ', 1)
        return said[1] if len(said) == 2 and os.path.isfile(said[1]) else None
    if choice in ('', 'theme'):
        return None
    path = os.path.expanduser(choice)
    return path if os.path.isfile(path) else None


def start_background():
    """The background as a picture the page can show: a JPEG no wider than a screen, small
    enough for one message to the browser, made once for each picture and kept."""
    kept = settings()
    source, stamp = background_source(kept['start_background']), kept['start_background_stamp']
    if not source:
        return {'stamp': ''}
    import hashlib
    made = f'{CACHE}/start-{hashlib.sha1(stamp.encode()).hexdigest()[:16]}.jpg'
    if not os.path.exists(made):
        os.makedirs(CACHE, exist_ok=True)
        for old in os.listdir(CACHE):
            if old.startswith('start-'):
                os.remove(f'{CACHE}/{old}')
        given = source
        if source.endswith('.svg'):
            # the theme's own picture is a drawing: it is made a picture first
            given = f'{CACHE}/start-drawing.png'
            out('rsvg-convert', '-w', '1920', '-o', given, source, timeout=30)
        for quality in ('4', '9', '15', '22'):
            # one frame, of a video too
            out('ffmpeg', '-y', '-loglevel', 'error', '-i', given, '-frames:v', '1', '-vf', "scale='min(1920,iw)':-2",
                '-q:v', quality, made, timeout=60)
            if os.path.exists(made) and os.path.getsize(made) < 700_000:
                break
        if given != source and os.path.exists(given):
            os.remove(given)
    try:
        with open(made, 'rb') as file:
            return {'stamp': stamp, 'picture': 'data:image/jpeg;base64,' + base64.b64encode(file.read()).decode()}
    except OSError:
        return {'stamp': '', 'failed': 'the picture could not be read'}


def set_start_background(message):
    """Choose it: the theme's colour, the desktop's background, a file, or a picture the page hands over."""
    value = str(message.get('value') or '')
    picture = str(message.get('picture') or '')
    if picture.startswith('data:image/') and ';base64,' in picture:
        os.makedirs(os.path.dirname(OWN_BACKGROUND), exist_ok=True)
        with open(OWN_BACKGROUND, 'wb') as file:
            file.write(base64.b64decode(picture.split(';base64,', 1)[1]))
        value = OWN_BACKGROUND
    elif value not in ('theme', 'wallpaper'):
        value = os.path.abspath(os.path.expanduser(value))
        if not os.path.isfile(value):
            return {'failed': f'there is no file {value}'}
    return set_line('start_background', value)


def page(message):
    """The title and the address a message carries, or why they cannot go to the notes."""
    title = re.sub(r'\s+', ' ', str(message.get('title') or 'A page')).strip()[:200]
    address = str(message.get('url') or '')
    if not re.match(r'https?://', address):
        return None, None, {'failed': 'only a page of the web can be saved to the notes'}
    # in a private session nothing of what is read is kept
    if mode() == 'incognito':
        return None, None, {'failed': 'in Incognito nothing is saved to the notes'}
    return title, address, None


def picture(message):
    """The picture a message carries, as a file kavat-notes can take; None when it has none."""
    found = re.match(r'data:image/(png|jpeg|webp);base64,(.+)', str(message.get('picture') or ''), re.S)
    if not found:
        return None
    try:
        data = base64.b64decode(found.group(2))
    except ValueError:
        return None
    file = tempfile.NamedTemporaryFile(prefix='kavat-browser-', suffix='.' + found.group(1).replace('jpeg', 'jpg'), delete=False)
    file.write(data)
    file.close()
    return file.name


def with_picture(message, *command, given=None):
    """Run kavat-notes with the message's picture as its last word, when it carries one."""
    file = picture(message)
    try:
        return out(*command, *([file] if file else []), timeout=30, given=given)
    finally:
        if file:
            os.remove(file)


def clip(message):
    """A page as a note: its title, its address, what was selected as a quote, a picture of
    it, and the comment and the tags written when it was saved."""
    title, address, problem = page(message)
    if problem:
        return problem
    quote = str(message.get('quote') or '').strip()[:20000]
    comment = re.sub(r'\s+', ' ', str(message.get('comment') or '')).strip()[:2000]
    # tags as they were typed: with or without their #, parted by spaces or commas
    tags = ' '.join(re.findall(r'[\w-]+', str(message.get('tags') or ''))[:20])
    saved = with_picture(message, 'kavat-notes', 'clip', '--comment', comment, '--tags', tags, title, address, given=quote)
    return {'said': 'Saved to the notes'} if saved is not None else {'failed': 'the notes did not take it'}


def album_name(message):
    name = re.sub(r'[^A-Za-z0-9 _-]', '', str(message.get('name') or '')).strip()[:60]
    return name or 'favourites'


def lines(text, *names):
    """Lines of fields parted by tabs, as kavat-notes writes them, as a list of what each is."""
    return [dict(zip(names, line.split('\t'))) for line in (text or '').splitlines() if line.strip()]


def inside_notes(path):
    """Whether a file is one of the notes: the only files this opens, reads or moves."""
    real = os.path.realpath(str(path))
    return real.startswith(NOTES + '/') and os.path.isfile(real)


def albums(message):
    ask = message['ask']
    if ask == 'albums':
        return {'albums': lines(out('kavat-notes', 'album'), 'name', 'count')}
    if ask == 'album':
        return {'name': album_name(message),
                'sites': lines(out('kavat-notes', 'album', 'show', album_name(message)), 'title', 'url', 'file', 'picture')}
    if ask == 'album-picture':
        # one picture at a time: a message to the browser cannot be larger than a megabyte
        path = str(message.get('file') or '')
        if not (inside_notes(path) and path.endswith('.jpg') and os.path.getsize(path) < 700000):
            return {'failed': 'there is no such picture'}
        with open(path, 'rb') as file:
            return {'picture': 'data:image/jpeg;base64,' + base64.b64encode(file.read()).decode()}
    if ask == 'album-add':
        title, address, problem = page(message)
        if problem:
            return problem
        name = album_name(message)
        saved = with_picture(message, 'kavat-notes', 'album', 'add', name, title, address)
        return {'said': f'Added to {name}'} if saved is not None else {'failed': 'the notes did not take it'}
    if ask == 'album-remove':
        done = out('kavat-notes', 'album', 'remove', album_name(message), str(message.get('url') or ''))
        return {} if done is not None else {'failed': 'it was not in the album'}
    if ask == 'album-read':
        path = str(message.get('file') or '')
        if not inside_notes(path):
            return {'failed': 'there is no such site'}
        return {} if out('kavat-notes', 'album', 'read', path) is not None else {'failed': 'the notes did not take it'}
    return {'failed': 'not understood'}


def about(message):
    """The notes there are about the site of an address."""
    address = str(message.get('url') or '')
    if not re.match(r'https?://', address) or mode() == 'incognito':
        return {'notes': []}
    return {'notes': lines(out('kavat-notes', 'about', address), 'title', 'file', 'kind')}


def open_note(message):
    path = str(message.get('file') or '')
    if not inside_notes(path):
        return {'failed': 'there is no such note'}
    subprocess.Popen(['kitty', '--directory', os.path.dirname(path), 'nvim', path], start_new_session=True,
                     stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return {}


# ---- the tabs that are open, for the launcher of the desktop

mine = set()  # the tabs of the browser this host is the line of, by their number


def keep_tabs(message):
    """The open tabs, as the extension tells them at each change, kept in this host's file."""
    told = [tab for tab in message.get('tabs') or [] if isinstance(tab, dict) and isinstance(tab.get('id'), int)]
    kept = [{'id': tab['id'], 'window': tab.get('window'), 'active': bool(tab.get('active')),
             'title': str(tab.get('title') or '')[:300], 'url': str(tab.get('url') or '')[:2000]} for tab in told]
    mine.clear()
    mine.update(tab['id'] for tab in kept)
    path = f'{TABS}/{os.getpid()}.json'
    os.makedirs(TABS, mode=0o700, exist_ok=True)
    with open(path + '.new', 'w', encoding='utf-8') as file:
        json.dump(kept, file)
    os.replace(path + '.new', path)
    return {}


def forget_tabs():
    try:
        os.remove(f'{TABS}/{os.getpid()}.json')
    except OSError:
        pass


def hyprctl(*arguments):
    for instance in ([], ['--instance', '0']):
        said = out('hyprctl', *instance, *arguments, timeout=10)
        if said is not None and 'HYPRLAND_INSTANCE_SIGNATURE' not in said:
            return said
    return ''


def browser_windows():
    """The browser's windows, as Hyprland has them."""
    try:
        return [window for window in json.loads(hyprctl('clients', '-j') or '[]') if window.get('class') == 'kavat-browser']
    except ValueError:
        return []


def open_tabs():
    """The tabs of every profile that is open. None while a mode keeps the browser out of
    sight, and none of a browser that is gone."""
    try:
        names = [name for name in os.listdir(TABS) if name.endswith('.json')]
    except OSError:
        return []
    if not out('pgrep', '-u', str(os.getuid()), '-f', f'user-data-dir={CONFIG}/kavat-browser'):
        for name in names:
            os.remove(f'{TABS}/{name}')
        return []
    if any(window.get('workspace', {}).get('name') == 'special:kavat-hidden' for window in browser_windows()):
        return []
    tabs = []
    for name in sorted(names):
        try:
            with open(f'{TABS}/{name}', encoding='utf-8') as file:
                tabs += json.load(file)
        except (OSError, ValueError):
            continue
    return tabs


def go_to_tab(wanted):
    """Bring a tab to the front, and its window with it. The tab is asked of the browser, as
    a command; the window is asked of Hyprland, which knows it by its title, and a window of
    the browser is called as the tab in view in it."""
    tabs = open_tabs()
    tab = next((tab for tab in tabs if str(tab['id']) == wanted), None)
    if tab is None:
        sys.exit('kavat-browser: there is no such tab open')
    path = f'{ASKED}/{time.time_ns()}'
    with open(path, 'w', encoding='utf-8') as file:
        json.dump({'name': 'go to tab', 'given': tab['id']}, file)
    os.replace(path, path + '.json')
    windows = browser_windows()
    shown = next((other['title'] for other in tabs if other['window'] == tab['window'] and other['active']), '')
    found = [window for window in windows if shown and str(window.get('title', '')).startswith(shown)]
    if not found and len(windows) == 1:
        found = windows
    if found:
        hyprctl('dispatch', f'hl.dsp.focus({{ window = "address:{found[0]["address"]}" }})')


def answer(message):
    ask = message.get('ask')
    if ask == 'tabs':
        return keep_tabs(message)
    if ask == 'mode':
        return {'mode': mode()}
    if ask == 'theme':
        return {'theme': theme()}
    if ask == 'commands':
        return {'commands': commands()}
    if ask == 'clip':
        return clip(message)
    if ask == 'settings':
        return {'settings': settings()}
    if ask == 'start-album':
        return set_start_album(message)
    if ask == 'start-background':
        return start_background()
    if ask == 'start-background-set':
        return set_start_background(message)
    if ask in ('albums', 'album', 'album-picture', 'album-add', 'album-remove', 'album-read'):
        return albums(message)
    if ask == 'about':
        return about(message)
    if ask == 'note':
        return open_note(message)
    if ask == 'folder':
        folder = out('xdg-user-dir', 'DOWNLOAD') or f'{HOME}/Downloads'
        os.makedirs(folder, exist_ok=True)
        subprocess.Popen(['/usr/lib/kavat/open-folder', folder], start_new_session=True,
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return {}
    return {'failed': 'not understood'}


def main():
    if sys.argv[1:2] == ['background']:
        # from a terminal, or the settings: kavat-browser background theme|wallpaper|<file>
        if len(sys.argv) != 3:
            sys.exit('usage: kavat-browser background theme|wallpaper|<file>')
        done = set_start_background({'value': sys.argv[2]})
        if done.get('failed'):
            sys.exit(f'kavat-browser: {done["failed"]}')
        print(done['settings']['start_background'])
        return
    if sys.argv[1:] == ['tabs']:
        # for the launcher: a tab to a line, its number, its title and its address
        for tab in open_tabs():
            title, address = (re.sub(r'\s+', ' ', tab[key]).strip() for key in ('title', 'url'))
            print(f'{tab["id"]}\t{title or address}\t{address}')
        return
    if sys.argv[1:2] == ['tab']:
        if len(sys.argv) != 3:
            sys.exit('usage: kavat-browser tab <number>, one of those `kavat-browser tabs` lists')
        go_to_tab(sys.argv[2])
        return
    os.makedirs(ASKED, mode=0o700, exist_ok=True)
    try:
        listen()
    finally:
        forget_tabs()


def listen():
    last_mode = mode()
    while True:
        ready, _, _ = select.select([sys.stdin.buffer], [], [], 1.0)
        if ready:
            message = read_message()
            if message is None:
                return  # the browser closed the line
            if 'number' in message:
                write_message({**answer(message), 'number': message['number']})
            continue
        # once a second: the mode, and what the system asked for
        now = mode()
        if now != last_mode:
            last_mode = now
            write_message({'event': 'mode', 'mode': now})
        for name in sorted(os.listdir(ASKED)):
            path = f'{ASKED}/{name}'
            if not name.endswith('.json'):
                continue  # the folder of the tabs, or a command still being written
            try:
                with open(path, encoding='utf-8') as file:
                    asked = json.load(file)
                if asked.get('name') == 'go to tab' and asked.get('given') not in mine:
                    # a tab of another profile, whose own host takes it; one nobody takes goes
                    if time.time() - os.path.getmtime(path) > 5:
                        os.remove(path)
                    continue
                os.remove(path)
            except (OSError, ValueError):
                continue
            write_message({'event': 'command', 'name': str(asked.get('name', '')), 'given': asked.get('given')})


if __name__ == '__main__':
    main()
