#!/usr/bin/env python3
"""The browser's line to the system: the program the Kavat extension talks to.

The browser starts it when the extension asks for it, and they speak in messages: four
bytes with the length, then that much JSON. The extension asks for the system theme's
colours, the mode in force, your own commands of the console, a clipping to be saved to
the notes, or a folder to be opened in Yazi. The other way, this tells the extension when
the system's mode changes, and passes on a command the system asks the browser for:
`kavat-browser command "<name>"` leaves it in a folder this watches.

Nothing here is reachable from a web page: only the Kavat extension may start it.
"""
import json
import os
import re
import select
import struct
import subprocess
import sys
import tomllib

HOME = os.path.expanduser('~')
CONFIG = os.environ.get('XDG_CONFIG_HOME') or f'{HOME}/.config'
STATE = os.environ.get('XDG_STATE_HOME') or f'{HOME}/.local/state'
RUNTIME = os.environ.get('XDG_RUNTIME_DIR') or f'/run/user/{os.getuid()}'
COMMANDS = f'{CONFIG}/kavat/browser/commands.toml'
MODE = f'{STATE}/kavat/mode.json'
ASKED = f'{RUNTIME}/kavat-browser'  # commands the system asks for, one file each
TOKENS = {'bg': 'bg', 'surface': 'surface', 'surface2': 'surface2', 'text': 'text', 'muted': 'muted',
          'border': 'border', 'accent': 'accent', 'on_accent': 'on_accent'}


def read_message():
    head = sys.stdin.buffer.read(4)
    if len(head) < 4:
        return None
    length = struct.unpack('=I', head)[0]
    if length > 1 << 20:
        return None
    try:
        return json.loads(sys.stdin.buffer.read(length))
    except ValueError:
        return {}


def write_message(message):
    data = json.dumps(message).encode()
    sys.stdout.buffer.write(struct.pack('=I', len(data)) + data)
    sys.stdout.buffer.flush()


def out(*command, timeout=15, given=None):
    try:
        done = subprocess.run(command, capture_output=True, text=True, timeout=timeout, check=False,
                              **({'input': given} if given is not None else {'stdin': subprocess.DEVNULL}))
    except (OSError, subprocess.TimeoutExpired):
        return None
    return done.stdout.strip() if done.returncode == 0 else None


def mode():
    try:
        with open(MODE, encoding='utf-8') as file:
            return json.load(file).get('mode', 'coder')
    except (OSError, ValueError):
        return 'coder'


def theme():
    """The colours in force, as kavat-theme says them: a name and its value, one to a line."""
    found = {}
    for line in (out('kavat-theme', 'tokens') or '').splitlines():
        name, _, value = line.partition(' ')
        found[name] = value.strip()
    wear = {ours: found[token] for ours, token in TOKENS.items() if token in found}
    for name in ('radius', 'mode'):
        if name in found:
            wear[name] = found[name]
    return wear


def commands():
    try:
        with open(COMMANDS, 'rb') as file:
            listed = tomllib.load(file).get('command', [])
    except (OSError, tomllib.TOMLDecodeError):
        return []
    return [{key: str(value) for key, value in one.items() if key in ('name', 'about', 'run', 'given', 'open')}
            for one in listed if isinstance(one, dict)]


def clip(message):
    """A page as a note: its title, its address, and what was selected as a quote."""
    title = re.sub(r'\s+', ' ', str(message.get('title') or 'A page')).strip()[:200]
    address = str(message.get('url') or '')
    if not re.match(r'https?://', address):
        return {'failed': 'only a page of the web can be saved to the notes'}
    quote = str(message.get('quote') or '').strip()[:20000]
    # in a private session nothing of what is read is kept
    if mode() == 'incognito':
        return {'failed': 'in Incognito nothing is saved to the notes'}
    saved = out('kavat-notes', 'clip', title, address, timeout=30, given=quote)
    return {'said': 'Saved to the notes'} if saved is not None else {'failed': 'the notes did not take it'}


def answer(message):
    ask = message.get('ask')
    if ask == 'mode':
        return {'mode': mode()}
    if ask == 'theme':
        return {'theme': theme()}
    if ask == 'commands':
        return {'commands': commands()}
    if ask == 'clip':
        return clip(message)
    if ask == 'folder':
        folder = out('xdg-user-dir', 'DOWNLOAD') or f'{HOME}/Downloads'
        os.makedirs(folder, exist_ok=True)
        subprocess.Popen(['/usr/lib/kavat/open-folder', folder], start_new_session=True,
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return {}
    return {'failed': 'not understood'}


def main():
    os.makedirs(ASKED, mode=0o700, exist_ok=True)
    last_mode = mode()
    while True:
        ready, _, _ = select.select([sys.stdin.buffer], [], [], 1.0)
        if ready:
            message = read_message()
            if message is None:
                return  # the browser closed the line
            if 'number' in message:
                write_message({**answer(message), 'number': message['number']})
            continue
        # once a second: the mode, and what the system asked for
        now = mode()
        if now != last_mode:
            last_mode = now
            write_message({'event': 'mode', 'mode': now})
        for name in sorted(os.listdir(ASKED)):
            path = f'{ASKED}/{name}'
            try:
                with open(path, encoding='utf-8') as file:
                    asked = json.load(file)
                os.remove(path)
            except (OSError, ValueError):
                continue
            write_message({'event': 'command', 'name': str(asked.get('name', '')), 'given': asked.get('given')})


if __name__ == '__main__':
    main()
