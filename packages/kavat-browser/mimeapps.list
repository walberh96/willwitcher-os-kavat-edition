# Part of kavat-browser: what opens each kind of thing, unless you choose otherwise.
[Default Applications]
text/html=kavat-browser.desktop
application/xhtml+xml=kavat-browser.desktop
x-scheme-handler/http=kavat-browser.desktop
x-scheme-handler/https=kavat-browser.desktop
# The viewers, which come with kavat-files: an image opens in imv, a PDF in zathura, and a
# video or a sound in mpv, not in the browser.
image/png=imv.desktop
image/jpeg=imv.desktop
image/gif=imv.desktop
image/webp=imv.desktop
image/bmp=imv.desktop
image/tiff=imv.desktop
image/svg+xml=imv.desktop
application/pdf=org.pwmt.zathura.desktop
video/mp4=mpv.desktop
video/x-matroska=mpv.desktop
video/webm=mpv.desktop
audio/mpeg=mpv.desktop
audio/flac=mpv.desktop
audio/ogg=mpv.desktop
