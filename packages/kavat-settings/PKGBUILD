pkgname=kavat-settings
pkgver=0.1.0
pkgrel=2
pkgdesc="Willwitcher-OS Kavat Edition: the system's settings, as a panel of the shell"
arch=('any')
url='https://github.com/walberh96/willwitcher-os-kavat-edition'
license=('LicenseRef-AllRightsReserved')
# the shell that draws the panel, and the programs its pages show and change
depends=('kavat-shell' 'kavat-theme' 'kav' 'kavat-notes' 'kitty')

# A plugin of the shell, in a folder the shell is pointed at by the theme's settings for it.
package() {
  install -d "$pkgdir/usr/share/kavat/shell-plugins"
  cp -r "$startdir/settings" "$pkgdir/usr/share/kavat/shell-plugins/settings"
  chmod -R u=rwX,go=rX "$pkgdir/usr/share/kavat"
}
