#!/usr/bin/env python3
"""kavat-wallpaper: the desktop's background, an image or a video that plays in a loop.

usage: kavat-wallpaper                  what the background is: theme, image or video, and its file
       kavat-wallpaper set <file>       an image (PNG, JPG, WebP, SVG) or a video (MP4, WebM, MKV, GIF)
       kavat-wallpaper set <file> <display>   an image or a video on one display only, the others keeping theirs
       kavat-wallpaper same <display>   that display shows what the others show again
       kavat-wallpaper displays         each display and the image or the video of its own, or - when it has none
       kavat-wallpaper theme            back to the theme's own picture
       kavat-wallpaper list             the library: each file of ~/Pictures/Wallpapers, what it is, and a picture of it
       kavat-wallpaper add <file>       copy a file into the library
       kavat-wallpaper search [--images|--live] <words>
                                        ask the sources that are on for wallpapers: what they answer, one to a
                                        line; only those of images, or only those of videos
       kavat-wallpaper fetch <address> [name]   download an image or a video to the library, and set it; get is the same
       kavat-wallpaper sources          each source of the search, whether it is on, and its name
       kavat-wallpaper source <name> on|off
       kavat-wallpaper pause|resume     stop the videos where they are, and let them go on
       kavat-wallpaper playing          whether a video is playing, paused, or there is none
       kavat-wallpaper option [<name> <value>]   the video's settings: sound, fit, gpu; slideshow: off, or the
                                        minutes after which the next image of the library is shown; and lock:
                                        background, the lock screen showing the background, or theme
       kavat-wallpaper next             the next image of the library, in the order of their names
       kavat-wallpaper palette          make a palette from the background and wear it
       kavat-wallpaper restore          at the start of a session: put the videos back, and make the palette
                                        the installer was asked to take from the background
       kavat-wallpaper lock again       point the lock screen at its picture again; the theme asks after a change

An image is drawn by the shell. A video is played by mpvpaper, over a still frame of it that
the shell draws: that frame is what shows while the video is stopped, and what the palette
is made from. A video for all the displays is one player; a display with a video of its
own has a player of its own. The library is two folders, as in Endgame:
~/Pictures/Wallpapers/images and ~/Pictures/Wallpapers/live.

The search asks the network, and nothing else here does. A source is a small TOML file,
the system's in /usr/share/kavat/wallpaper-sources and yours in
~/.config/kavat/wallpaper-sources, one of yours replacing the system's of the same name:

    name = "Wallhaven"                      what it is called
    search = "https://…?q={words}"          the address a search is sent to; {words} is where they go
    list = "data"                           where in the JSON answer the list of pictures is
    id = "id"                               and in each picture: a name for it,
    small = "thumbs.small"                  the small picture's address,
    full = "path"                           the full one's,
    size = "resolution"                     and its size as 1920x1080; or width = and height =
    kind = "video"                          what it gives, when it is videos and not images

A place in the answer is its keys joined by dots; a number is a place in a list. A source
that answers with a page and not with data has `each` in place of `list`: a regular
expression that matches once for each wallpaper on the page, with named groups; its id,
small, full and size are then texts in which {group} is what that group matched, and an
address that begins with / is the site's. search prints one wallpaper to a line, seven
columns with tabs between them, - for one that is missing: the source, the wallpaper's
name there, the small picture's address, the full one's, its size as WxH, the file the
small picture was downloaded to, under ~/.cache/kavat/wallpaper/online, and image or
video. Only the first 24 of each source are listed.
"""
import colorsys
import hashlib
import html
import http.client
import json
import os
import re
import shutil
import socket
import subprocess
import sys
import time
import tomllib
import urllib.error
import urllib.parse
import urllib.request
from concurrent.futures import ThreadPoolExecutor

HOME = os.path.expanduser('~')
CONFIG = os.environ.get('XDG_CONFIG_HOME') or f'{HOME}/.config'
CACHE = (os.environ.get('XDG_CACHE_HOME') or f'{HOME}/.cache') + '/kavat/wallpaper'
STATE_HOME = os.environ.get('XDG_STATE_HOME') or f'{HOME}/.local/state'
RUNTIME = os.environ.get('XDG_RUNTIME_DIR') or f'/run/user/{os.getuid()}'
SETTINGS = f'{CONFIG}/kavat/wallpaper.json'
LIBRARY = {'image': f'{HOME}/Pictures/Wallpapers/images', 'video': f'{HOME}/Pictures/Wallpapers/live'}
KINDS = {'image': ('.png', '.jpg', '.jpeg', '.webp', '.svg'), 'video': ('.mp4', '.webm', '.mkv', '.gif', '.mov')}
SOCKET = f'{RUNTIME}/kavat-wallpaper.sock'
UNIT = 'kavat-wallpaper-video'
SLIDES = 'kavat-wallpaper-slideshow'
OPTIONS = {'sound': ('off', 'on'), 'fit': ('fill', 'fit', 'stretch'), 'gpu': ('on', 'off'), 'slideshow': ('off', '5', '15', '30', '60'),
           'lock': ('background', 'theme')}
LOCK = (os.environ.get('XDG_CACHE_HOME') or f'{HOME}/.cache') + '/kavat/lock'
FETCHED = {}                           # what the last download said of itself: the name of its file
SOURCES = ('/usr/share/kavat/wallpaper-sources', f'{CONFIG}/kavat/wallpaper-sources')
ONLINE = f'{CACHE}/online'
PAGE = 24                              # how many pictures of each source a search lists
SMALL, FULL = 2 << 20, 60 << 20        # the most a small picture and a wallpaper may weigh
VIDEO = 300 << 20                      # and a video


def settings():
    try:
        with open(SETTINGS, encoding='utf-8') as file:
            return json.load(file)
    except (OSError, ValueError):
        return {}


def save(value):
    os.makedirs(os.path.dirname(SETTINGS), exist_ok=True)
    with open(SETTINGS + '.new', 'w', encoding='utf-8') as file:
        json.dump(value, file, indent=2)
        file.write('\n')
    os.replace(SETTINGS + '.new', SETTINGS)


def run(*command, timeout=30):
    try:
        done = subprocess.run(command, capture_output=True, text=True, timeout=timeout, check=False)
    except (OSError, subprocess.TimeoutExpired):
        return None
    return done.stdout.strip() if done.returncode == 0 else None


def kind_of(path):
    ending = os.path.splitext(path)[1].lower()
    return next((kind for kind, endings in KINDS.items() if ending in endings), None)


def theme_picture():
    folder = f'{STATE_HOME}/kavat/theme/current/wallpaper'
    try:
        return next(f'{folder}/{name}' for name in sorted(os.listdir(folder)) if name.endswith('.svg'))
    except (OSError, StopIteration):
        return None


def still_of(video):
    """One frame of a video, kept: what the shell draws under it."""
    stamp = hashlib.sha1(f'{video}{os.path.getmtime(video)}'.encode()).hexdigest()[:16]
    still = f'{CACHE}/{stamp}.png'
    if not os.path.exists(still):
        os.makedirs(CACHE, exist_ok=True)
        # a second in, so that it is not the black a video often starts with; the first frame when it is shorter
        for at in ('1', '0'):
            run('ffmpeg', '-y', '-loglevel', 'error', '-ss', at, '-i', video, '-frames:v', '1', still, timeout=60)
            if os.path.exists(still):
                break
    return still if os.path.exists(still) else None


def shell_shows(picture, display=None):
    """Tell the shell its picture, for all the displays or for one. It may still be starting."""
    for _ in range(20):
        if run('kavat-shell', 'msg', 'wallpaper-set', *([display] if display else []), picture, timeout=5) is not None:
            return True
        time.sleep(0.5)
    return False


def unit_of(display=None):
    """The unit of the session that plays the video: one for all the displays, or one display's own."""
    return f'{UNIT}-{display}' if display else UNIT


def socket_of(display=None):
    return f'{RUNTIME}/kavat-wallpaper-{display}.sock' if display else SOCKET


def stop_video(display=None):
    run('systemctl', '--user', 'stop', f'{unit_of(display)}.service')
    run('systemctl', '--user', 'reset-failed', f'{unit_of(display)}.service')


def stop_videos():
    """The video for all the displays and those of each display."""
    for units in (f'{UNIT}.service', f'{UNIT}-*.service'):
        run('systemctl', '--user', 'stop', units)
        run('systemctl', '--user', 'reset-failed', units)


def play(video, now, display=None):
    """mpvpaper on every screen, or on one, as a unit of the session, so that it is one and can be stopped."""
    stop_video(display)
    fit = {'fill': 'panscan=1.0', 'fit': 'panscan=0.0', 'stretch': 'keepaspect=no'}[now.get('fit', 'fill')]
    options = ['loop-file=inf', fit, f'input-ipc-server={socket_of(display)}',
               'hwdec=auto-safe' if now.get('gpu', 'on') == 'on' else 'hwdec=no']
    if now.get('sound', 'off') != 'on':
        options.append('no-audio')
    # --auto-pause: the video stops while a window covers the whole of it
    return run('systemd-run', '--user', '--quiet', '--collect', '--unit', unit_of(display),
               '--description', f'The video on {display}' if display else 'The video on the desktop',
               'mpvpaper', '--auto-pause', '-o', ' '.join(options), display or 'ALL', video) is not None


def players(now):
    """Each video that is to play: the display it is on, None for all of them, and its file."""
    found = []
    if now.get('kind') == 'video' and os.path.exists(now.get('file', '')):
        found.append((None, now['file']))
    for display, path in now.get('displays', {}).items():
        if kind_of(path) == 'video' and os.path.isfile(path):
            found.append((display, path))
    return found


def tell_player(display, *command):
    """A word to a running video, through mpv's own socket."""
    try:
        with socket.socket(socket.AF_UNIX) as player:
            player.settimeout(2)
            player.connect(socket_of(display))
            player.sendall(json.dumps({'command': list(command)}).encode() + b'\n')
            answer = json.loads(player.recv(4096).split(b'\n')[0])
        return answer.get('data', True)
    except (OSError, ValueError):
        return None


def slideshow(now):
    """A timer of the session that shows the next image every so many minutes, or none."""
    run('systemctl', '--user', 'stop', f'{SLIDES}.timer')
    run('systemctl', '--user', 'reset-failed', f'{SLIDES}.service')
    minutes = now.get('slideshow', 'off')
    if minutes != 'off':
        run('systemd-run', '--user', '--quiet', '--collect', '--unit', SLIDES, '--description', 'The next background',
            f'--on-active={minutes}m', f'--on-unit-active={minutes}m', 'kavat-wallpaper', 'next')


def next_image():
    folder = LIBRARY['image']
    try:
        images = [f'{folder}/{name}' for name in sorted(os.listdir(folder)) if kind_of(name) == 'image']
    except OSError:
        images = []
    if not images:
        sys.exit('kavat-wallpaper: there is no image in ' + folder)
    current = settings().get('file')
    set_to(images[(images.index(current) + 1) % len(images)] if current in images else images[0])


def display_names():
    # asked as the session does, and then by number: a command run from outside it has no session of its own
    for instance in ([], ['--instance', '0']):
        try:
            return [monitor['name'] for monitor in json.loads(run('hyprctl', *instance, 'monitors', '-j') or '')]
        except (ValueError, KeyError, TypeError):
            continue
    return []


def set_on(path, display):
    """An image or a video of its own for one display. A video for all of them covers this."""
    path = os.path.abspath(os.path.expanduser(path))
    kind = kind_of(path)
    if not os.path.isfile(path) or kind is None:
        sys.exit(f'kavat-wallpaper: {path} is not an image or a video this can show')
    if display not in display_names():
        sys.exit(f'kavat-wallpaper: there is no display called {display}')
    now = settings()
    if now.get('kind') == 'video':
        sys.exit('kavat-wallpaper: a video is playing on every display; set an image or the theme first')
    picture = path
    if kind == 'video':
        if not shutil.which('mpvpaper'):
            sys.exit('kavat-wallpaper: a video needs mpvpaper, which is not installed')
        picture = still_of(path)
        if picture is None:
            sys.exit(f'kavat-wallpaper: no frame could be read from {path}')
    if run('kavat-shell', 'msg', 'wallpaper-set', display, picture, timeout=5) is None:
        sys.exit('kavat-wallpaper: the shell did not take the image')
    if kind == 'video':
        if not play(path, now, display):
            sys.exit('kavat-wallpaper: the video could not be started')
    else:
        stop_video(display)
    now.setdefault('displays', {})[display] = path
    save(now)


def same_on(display):
    now = settings()
    if now.get('displays', {}).pop(display, None) is None:
        return
    save(now)
    stop_video(display)
    picture = now['file'] if now.get('kind') == 'image' and os.path.exists(now.get('file', '')) else theme_picture()
    if picture:
        run('kavat-shell', 'msg', 'wallpaper-set', display, picture, timeout=5)


def displays_again():
    """Put back the pictures of the displays that have one of their own, after all were given the same."""
    names = display_names()
    for display, path in settings().get('displays', {}).items():
        if display in names and os.path.isfile(path):
            picture = still_of(path) if kind_of(path) == 'video' else path
            if picture:
                run('kavat-shell', 'msg', 'wallpaper-set', display, picture, timeout=5)


def set_to(path):
    path = os.path.abspath(os.path.expanduser(path))
    kind = kind_of(path)
    if not os.path.isfile(path) or kind is None:
        sys.exit(f'kavat-wallpaper: {path} is not an image or a video this can show')
    now = settings()
    if kind == 'video':
        if not shutil.which('mpvpaper'):
            sys.exit('kavat-wallpaper: a video needs mpvpaper, which is not installed')
        still = still_of(path)
        if still is None:
            sys.exit(f'kavat-wallpaper: no frame could be read from {path}')
        shell_shows(still)
        stop_videos()
        if not play(path, now):
            sys.exit('kavat-wallpaper: the video could not be started')
    else:
        stop_videos()
        shell_shows(path)
    now.update(kind=kind, file=path)
    now.pop('displays', None)
    save(now)
    lock_picture()
    follow()


def to_theme():
    stop_videos()
    now = settings()
    now.pop('kind', None)
    now.pop('file', None)
    now.pop('displays', None)
    save(now)
    picture = theme_picture()
    if picture:
        shell_shows(picture)
    lock_picture()


def lock_picture():
    """Point the lock screen at its picture: the background, a video's still frame, or the theme's.

    hyprlock is told one name, background.png, and that is a link to the picture in force.
    The theme's is the copy /usr/lib/kavat/wallpaper keeps there; it is the one when the
    background is the theme's, or with `option lock theme`."""
    now = settings()
    picture = None
    if now.get('lock', OPTIONS['lock'][0]) == 'background' and os.path.exists(now.get('file', '')):
        if now.get('kind') == 'video':
            picture = still_of(now['file'])
        elif now.get('kind') == 'image':
            picture = png_of(now['file'])
    if picture is None:
        theme = theme_picture()
        if theme is None:
            return
        picture = f'{LOCK}/{os.path.basename(theme)[:-4]}.png'
    os.makedirs(LOCK, exist_ok=True)
    link = f'{LOCK}/background.png'
    try:
        if os.path.lexists(link + '.new'):
            os.remove(link + '.new')
        os.symlink(picture, link + '.new')
        os.replace(link + '.new', link)
    except OSError:
        pass


def png_of(image):
    """An image as a PNG, which is what the lock screen is sure to read: itself, or a copy kept for it."""
    if image.lower().endswith('.png'):
        return image
    stamp = hashlib.sha1(f'{image}{os.path.getmtime(image)}'.encode()).hexdigest()[:16]
    copy = f'{LOCK}/own-{stamp}.png'
    if not os.path.exists(copy):
        os.makedirs(LOCK, exist_ok=True)
        for name in os.listdir(LOCK):
            if name.startswith('own-'):
                os.remove(f'{LOCK}/{name}')
        if image.lower().endswith('.svg'):
            run('rsvg-convert', '-w', '2560', '-o', copy, image)
        else:
            run('ffmpeg', '-y', '-loglevel', 'error', '-i', image, '-frames:v', '1', copy, timeout=60)
    return copy if os.path.exists(copy) else None


# ---- pictures from the network

def web(address):
    """Whether it is an address of the web, and nothing else: no file, no other way in."""
    return isinstance(address, str) and re.fullmatch(r'https?://[^\s\x00-\x1f\x7f]+', address) is not None


def download(address, limit, seconds):
    """What a web address answers, up to a size and within a time.

    Only http and https are spoken, also where the answer sends on to another address."""
    if not web(address):
        raise ValueError('not a web address')
    opener = urllib.request.OpenerDirector()
    for handler in (urllib.request.HTTPHandler, urllib.request.HTTPSHandler, urllib.request.HTTPRedirectHandler,
                    urllib.request.HTTPDefaultErrorHandler, urllib.request.HTTPErrorProcessor, urllib.request.UnknownHandler):
        opener.add_handler(handler())
    until = time.monotonic() + seconds
    data = b''
    with opener.open(urllib.request.Request(address, headers={'User-Agent': 'kavat-wallpaper'}), timeout=min(seconds, 15)) as answer:
        said = re.search(r'filename="?([^";]+)', answer.headers.get('Content-Disposition') or '')
        FETCHED['name'] = os.path.basename(said.group(1)) if said else None
        while chunk := answer.read(1 << 16):
            data += chunk
            if len(data) > limit:
                raise ValueError('too large')
            if time.monotonic() > until:
                raise TimeoutError('too slow')
    return data


def image_ending(data):
    """The ending for the name of a picture, read from what it is and not from what it is called."""
    if data.startswith(b'\x89PNG\r\n\x1a\n'):
        return '.png'
    if data.startswith(b'\xff\xd8\xff'):
        return '.jpg'
    if data[:4] == b'RIFF' and data[8:12] == b'WEBP':
        return '.webp'
    return None


def sources():
    """Each source by the name of its file, yours after the system's and in place of one of the same name."""
    found = {}
    for folder in SOURCES:
        try:
            names = sorted(os.listdir(folder))
        except OSError:
            continue
        for name in names:
            if not name.endswith('.toml'):
                continue
            try:
                with open(f'{folder}/{name}', 'rb') as file:
                    source = tomllib.load(file)
            except (OSError, ValueError):
                continue
            if (all(isinstance(source.get(key), str) for key in ('search', 'small', 'full')) and web(source['search'])
                    and isinstance(source.get('each', source.get('list')), str) and source.get('kind', 'image') in LIBRARY):
                found[name[:-5]] = source
    return found


def at(answer, place):
    """What an answer has at a place: its keys joined by dots, a number for a place in a list."""
    for key in place.split('.') if isinstance(place, str) and place else []:
        if isinstance(answer, dict):
            answer = answer.get(key)
        elif isinstance(answer, list) and key.isdigit() and int(key) < len(answer):
            answer = answer[int(key)]
        else:
            return None
    return answer


def small_picture(address):
    """A small picture, downloaded once: the file it is kept in, or None."""
    stem = f'{ONLINE}/{hashlib.sha1(address.encode()).hexdigest()[:16]}'
    for ending in ('.jpg', '.png', '.webp'):
        if os.path.exists(stem + ending):
            return stem + ending
    try:
        data = download(address, SMALL, 10)
    except (OSError, ValueError, http.client.HTTPException):
        return None
    ending = image_ending(data)
    if ending is None:
        return None
    with open(stem + '.part', 'wb') as file:
        file.write(data)
    os.replace(stem + '.part', stem + ending)
    return stem + ending


def on_page(page, source):
    """The wallpapers a page lists, for a source that answers with one: each as data would give it."""
    found = []
    try:
        each = re.compile(source['each'], re.S)
    except re.error:
        return found
    site = '{0.scheme}://{0.netloc}'.format(urllib.parse.urlsplit(source['search']))
    for match in each.finditer(page):
        groups = {name: html.unescape(value or '') for name, value in match.groupdict().items()}
        filled = {}
        for key in ('id', 'small', 'full', 'size'):
            text = source.get(key)
            if isinstance(text, str):
                text = re.sub(r'\{(\w+)\}', lambda group: groups.get(group.group(1), ''), text)
                filled[key] = site + text if key in ('small', 'full') and text.startswith('/') else text
        found.append(filled)
    return found


def search(words, kind=None):
    now = settings()
    asked = {name: source for name, source in sources().items()
             if name not in now.get('sources_off', []) and kind in (None, source.get('kind', 'image'))}
    if not asked:
        sys.exit('kavat-wallpaper: no source ' + ('of those ' if kind else '') + 'is on; kavat-wallpaper sources lists them')
    found, failed, reached = [], [], False
    for name, source in asked.items():
        title = source.get('name', name)
        try:
            answer = download(source['search'].replace('{words}', urllib.parse.quote_plus(words)), 4 << 20, 20)
            answer = answer.decode('utf-8', 'replace') if 'each' in source else json.loads(answer)
        except urllib.error.HTTPError as error:
            reached = True
            failed.append(f'{title} answered with error {error.code}')
            continue
        except (OSError, http.client.HTTPException):
            failed.append(f'{title} could not be reached')
            continue
        except ValueError:
            reached = True
            failed.append(f'{title} did not answer with data')
            continue
        reached = True
        if 'each' in source:
            # a page: what its expression matched is already each wallpaper's own
            pictures, place = on_page(answer, source), lambda picture, key: picture.get(key)
        else:
            pictures, place = at(answer, source['list']), lambda picture, key: at(picture, source.get(key))
        for picture in pictures[:PAGE] if isinstance(pictures, list) else []:
            small, full = place(picture, 'small'), place(picture, 'full')
            if not web(small) or not web(full):
                continue
            size = place(picture, 'size')
            if 'width' in source and 'each' not in source:
                size = f'{at(picture, source["width"])}x{at(picture, source.get("height"))}'
            size = size if isinstance(size, str) and re.fullmatch(r'\d+x\d+', size) else '-'
            called = re.sub(r'\s+', ' ', str(place(picture, 'id') or '')).strip() or os.path.basename(urllib.parse.urlsplit(full).path)
            found.append([name, called or '-', small, full, size, source.get('kind', 'image')])
    if not found and failed:
        sys.exit('kavat-wallpaper: ' + ('; '.join(failed) if reached else 'there is no network, so nothing could be searched'))
    for failure in failed:
        print('kavat-wallpaper: ' + failure, file=sys.stderr)
    os.makedirs(ONLINE, exist_ok=True)
    with ThreadPoolExecutor(8) as pool:
        kept = list(pool.map(small_picture, [picture[2] for picture in found]))
    for picture, file in zip(found, kept):
        print('\t'.join(picture[:5] + [file or '-', picture[5]]))
    # the small pictures of earlier searches go after a day
    for name in os.listdir(ONLINE):
        file = f'{ONLINE}/{name}'
        if file not in kept and os.path.getmtime(file) < time.time() - 86400:
            os.remove(file)


def video_ending(data):
    """The ending for the name of a video, read from what it is: MP4 or WebM."""
    if data[4:8] == b'ftyp':
        return '.mp4'
    if data.startswith(b'\x1a\x45\xdf\xa3'):
        return '.webm'
    return None


def fetch(address, name=None):
    """Download an image or a video to the library, and set it as the background."""
    if not web(address):
        sys.exit(f'kavat-wallpaper: {address} is not an http or https address')
    try:
        data = download(address, VIDEO, 900)
    except urllib.error.HTTPError as error:
        sys.exit(f'kavat-wallpaper: the wallpaper was not given: error {error.code}')
    except ValueError:
        sys.exit(f'kavat-wallpaper: the wallpaper is larger than {VIDEO >> 20} MB')
    except TimeoutError:
        sys.exit('kavat-wallpaper: the wallpaper took too long to arrive')
    except (OSError, http.client.HTTPException):
        sys.exit('kavat-wallpaper: there is no network, so the wallpaper could not be downloaded')
    ending, kind = image_ending(data), 'image'
    if ending is None:
        ending, kind = video_ending(data), 'video'
    if ending is None:
        sys.exit('kavat-wallpaper: what that address gives is not a PNG, JPG or WebP image, or an MP4 or WebM video')
    if kind == 'image' and len(data) > FULL:
        sys.exit(f'kavat-wallpaper: the picture is larger than {FULL >> 20} MB')
    if name is None:
        # a video is called what its site calls it, when it says
        name = FETCHED.get('name')
    # the name it is kept under: letters, digits, dots and dashes of the one given, or of the address's
    stem = os.path.splitext(os.path.basename(name or urllib.parse.urlsplit(address).path))[0]
    stem = re.sub(r'[^A-Za-z0-9._-]+', '-', stem).strip('.-')[:80] or 'wallpaper'
    os.makedirs(LIBRARY[kind], exist_ok=True)
    path, number = f'{LIBRARY[kind]}/{stem}{ending}', 1
    while os.path.exists(path):
        with open(path, 'rb') as file:
            if file.read() == data:
                break
        number += 1
        path = f'{LIBRARY[kind]}/{stem}-{number}{ending}'
    else:
        with open(path + '.part', 'wb') as file:
            file.write(data)
        os.replace(path + '.part', path)
    print(path)
    set_to(path)


def shown():
    """The picture on the desktop now: the image, the video's still, or the theme's."""
    now = settings()
    if now.get('kind') == 'video' and os.path.exists(now.get('file', '')):
        return still_of(now['file'])
    if now.get('kind') == 'image' and os.path.exists(now.get('file', '')):
        return now['file']
    return run('kavat-shell', 'msg', 'wallpaper-get', timeout=5) or theme_picture()


# ---- a palette from the picture

NAMES = [(15, 'red'), (40, 'orange'), (70, 'yellow'), (165, 'green'), (200, 'cyan'), (255, 'blue'), (290, 'purple'), (335, 'pink'), (361, 'red')]


def colour(hue, lightness, saturation):
    red, green, blue = colorsys.hls_to_rgb(hue % 360 / 360, lightness, saturation)
    return f'#{round(red * 255):02x}{round(green * 255):02x}{round(blue * 255):02x}'


def palette_from(picture):
    """The colours of a picture as a palette of the theme: its file's text.

    The neutrals take the hue most of the picture has; the accents are the hues that
    stand out in it. kavat-theme adjusts whatever does not read well enough."""
    source = picture
    if picture.lower().endswith('.svg'):
        # a drawing is made a picture first
        os.makedirs(CACHE, exist_ok=True)
        source = f'{CACHE}/drawing.png'
        run('rsvg-convert', '-w', '256', '-o', source, picture)
    raw = subprocess.run(['ffmpeg', '-loglevel', 'error', '-i', source, '-frames:v', '1', '-vf', 'scale=64:64',
                          '-f', 'rawvideo', '-pix_fmt', 'rgb24', '-'], capture_output=True, check=False).stdout
    if len(raw) < 64 * 64 * 3:
        sys.exit(f'kavat-wallpaper: {picture} could not be read')
    area, vivid, strength = [0.0] * 24, [0.0] * 24, [0.0] * 24
    for at in range(0, 64 * 64 * 3, 3):
        hue, lightness, saturation = colorsys.rgb_to_hls(raw[at] / 255, raw[at + 1] / 255, raw[at + 2] / 255)
        bin_ = int(hue * 24) % 24
        weight = saturation * (1 - abs(2 * lightness - 1))  # how much colour the eye sees in it
        area[bin_] += 0.05 + weight
        vivid[bin_] += weight * weight
        strength[bin_] += weight
    base = max(range(24), key=lambda bin_: area[bin_]) * 15 + 7
    colourful = sum(strength) / (64 * 64)  # 0 for a grey picture
    tint = min(0.22, 0.06 + colourful * 0.5)

    # the hues that stand out, each at least 45 degrees from the ones already taken
    accents = []
    for bin_ in sorted(range(24), key=lambda bin_: -vivid[bin_]):
        hue = bin_ * 15 + 7
        if vivid[bin_] > 0 and all(min(abs(hue - other), 360 - abs(hue - other)) >= 45 for other in accents):
            accents.append(hue)
        if len(accents) == 5:
            break
    if not accents:
        accents = [base]
    # a picture of one colour still gets a choice: what is across and beside it
    for turn in (180, 120, 240):
        if len(accents) < 3:
            accents.append((accents[0] + turn) % 360)
    vividness = min(0.8, max(0.5, 0.45 + colourful * 2))

    lines = ['# Made by kavat-wallpaper from the background: ' + picture,
             '# `kavat-wallpaper palette` makes it again; a copy under another name is yours to keep.', '',
             'name = "Wallpaper"', '', '[accents]']
    taken = {}
    for hue in accents:
        name = next(name for limit, name in NAMES if hue < limit)
        taken[name] = taken.get(name, 0) + 1
        lines.append(f'{name if taken[name] == 1 else name + str(taken[name])} = "{colour(hue, 0.62, vividness)}"')
    hues = {'red': 2, 'green': 130, 'yellow': 45, 'blue': 215, 'magenta': 300, 'cyan': 185}
    for side, neutrals, light in (('dark', {'bg': 0.065, 'surface': 0.10, 'surface2': 0.145, 'text': 0.92, 'muted': 0.68, 'border': 0.25}, 0.64),
                                  ('light', {'bg': 0.93, 'surface': 0.975, 'surface2': 0.895, 'text': 0.15, 'muted': 0.38, 'border': 0.80}, 0.42)):
        lines += ['', f'[{side}]']
        for name, lightness in neutrals.items():
            lines.append(f'{name} = "{colour(base, lightness, tint if name not in ("text", "muted") else tint * 0.6)}"')
        lines.append('')
        for name, hue in hues.items():
            lines.append(f'{name} = "{colour(hue, light, vividness * 0.85)}"')
    return '\n'.join(lines) + '\n'


def wear_palette():
    """Write the palette of the background in force, and have the theme wear it."""
    picture = shown()
    if not picture or not os.path.exists(picture):
        sys.exit('kavat-wallpaper: there is no background to take the colours from')
    folder = f'{CONFIG}/kavat/palettes'
    os.makedirs(folder, exist_ok=True)
    text = palette_from(picture)
    with open(f'{folder}/wallpaper.toml', 'w', encoding='utf-8') as file:
        file.write(text)
    first = text.split('[accents]\n', 1)[1].split(' ', 1)[0]
    return subprocess.run(['kavat-theme', 'set', 'palette', 'wallpaper', 'accent', first], check=False).returncode


def first_palette(now):
    """The installer's "From wallpaper": the palette is made at the first session, once.

    The installer cannot make it: there is no background until somebody logs in. It leaves
    the wish in the settings every new user starts with, and it is granted here. When the
    palette cannot be made, the wish stays for the next session."""
    if now.get('colours') != 'background':
        return
    try:
        made = wear_palette() == 0
    except SystemExit:
        made = False
    if made:
        del now['colours']
        save(now)


def follow():
    """With the theme taking its colours from the background, a new background is new colours."""
    if run('kavat-theme', 'get', 'palette') == 'wallpaper':
        wear_palette()


def main():
    arguments = sys.argv[1:]
    now = settings()
    if not arguments:
        print(now.get('kind', 'theme'), now.get('file', theme_picture() or ''))
    elif arguments[0] == 'set' and len(arguments) == 2:
        set_to(arguments[1])
    elif arguments[0] == 'set' and len(arguments) == 3:
        set_on(arguments[1], arguments[2])
    elif arguments[0] == 'same' and len(arguments) == 2:
        same_on(arguments[1])
    elif arguments == ['displays']:
        own = now.get('displays', {})
        for name in display_names():
            print(f'{name}\t{own.get(name, "-")}')
    elif arguments == ['displays', 'again']:
        displays_again()
    elif arguments == ['theme']:
        to_theme()
    elif arguments == ['list']:
        # each line: what it is, the file, and a picture of it to show small
        picture = theme_picture()
        if picture:
            lock = (os.environ.get('XDG_CACHE_HOME') or f'{HOME}/.cache') + '/kavat/lock/' + os.path.basename(picture)[:-4] + '.png'
            print(f'theme\t{picture}\t{lock if os.path.exists(lock) else picture}')
        for kind, folder in LIBRARY.items():
            os.makedirs(folder, exist_ok=True)
            for name in sorted(os.listdir(folder)):
                if kind_of(name) == kind:
                    path = f'{folder}/{name}'
                    print(f'{kind}\t{path}\t{(still_of(path) or path) if kind == "video" else path}')
    elif arguments[0] == 'add' and len(arguments) == 2:
        kind = kind_of(arguments[1])
        if kind is None or not os.path.isfile(arguments[1]):
            sys.exit(f'kavat-wallpaper: {arguments[1]} is not an image or a video this can show')
        os.makedirs(LIBRARY[kind], exist_ok=True)
        print(shutil.copy2(arguments[1], LIBRARY[kind]))
    elif arguments[0] == 'search' and len(arguments) > 2 and arguments[1] in ('--images', '--live'):
        search(' '.join(arguments[2:]), 'image' if arguments[1] == '--images' else 'video')
    elif arguments[0] == 'search' and len(arguments) > 1:
        search(' '.join(arguments[1:]))
    elif arguments[0] in ('fetch', 'get') and len(arguments) in (2, 3):
        fetch(*arguments[1:])
    elif arguments == ['sources']:
        for name, source in sources().items():
            print(f'{name}\t{"off" if name in now.get("sources_off", []) else "on"}\t{source.get("name", name)}')
    elif arguments[0] == 'source' and len(arguments) == 3 and arguments[2] in ('on', 'off'):
        if arguments[1] not in sources():
            sys.exit(f'kavat-wallpaper: there is no source called {arguments[1]}; kavat-wallpaper sources lists them')
        off = [name for name in now.get('sources_off', []) if name != arguments[1]] + ([arguments[1]] if arguments[2] == 'off' else [])
        now['sources_off'] = off
        if not off:
            del now['sources_off']
        save(now)
    elif arguments in (['pause'], ['resume']):
        for display, _ in players(now):
            tell_player(display, 'set_property', 'pause', arguments[0] == 'pause')
    elif arguments == ['playing']:
        # paused when every video is; one that goes on is a video playing
        paused = [state for state in (tell_player(display, 'get_property', 'pause') for display, _ in players(now)) if state is not None]
        print('none' if not paused else 'paused' if all(paused) else 'playing')
    elif arguments[0] == 'option' and len(arguments) == 1:
        for name, values in OPTIONS.items():
            print(name, now.get(name, values[0]))
    elif arguments[0] == 'option' and len(arguments) == 3:
        name, value = arguments[1:]
        if name not in OPTIONS or value not in OPTIONS[name]:
            sys.exit('kavat-wallpaper: the options are ' + '; '.join(f'{name}: {", ".join(values)}' for name, values in OPTIONS.items()))
        now[name] = value
        save(now)
        if name == 'slideshow':
            slideshow(now)
        elif name == 'lock':
            lock_picture()
        else:
            for display, video in players(now):
                play(video, now, display)
    elif arguments == ['lock', 'again']:
        lock_picture()
    elif arguments == ['palette']:
        sys.exit(wear_palette())
    elif arguments == ['next']:
        next_image()
    elif arguments == ['restore']:
        first_palette(now)
        slideshow(now)
        lock_picture()
        names = display_names()
        for display, video in players(now):
            if display is None or display in names:
                still = still_of(video)
                if still:
                    shell_shows(still, display)
                play(video, now, display)
    else:
        sys.exit(__doc__)


if __name__ == '__main__':
    main()
