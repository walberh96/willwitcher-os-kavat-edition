pkgname=kavat-files
pkgver=0.1.0
pkgrel=7
pkgdesc="Willwitcher-OS Kavat Edition: Yazi as the file manager of the whole system"
arch=('any')
url='https://github.com/walberh96/willwitcher-os-kavat-edition'
license=('LicenseRef-AllRightsReserved')
# Yazi and the terminal it opens in; what its previews are made with; the file search and
# the editor its keys open; what compresses, mounts and copies; and what makes it
# the window that picks files and the answer to "show in folder"
depends=('yazi' 'kitty' 'imv' 'zathura' 'zathura-pdf-mupdf' 'mpv'
         'ffmpeg' 'poppler' 'imagemagick' 'resvg' '7zip' 'jq' 'mediainfo' 'file'
         'kavat-find' 'fd' 'ripgrep' 'fzf' 'zoxide' 'neovim'
         'ouch' 'udisks2' 'udiskie' 'xdg-desktop-portal-gtk' 'wl-clipboard' 'xdg-utils'
         'xdg-desktop-portal' 'xdg-desktop-portal-hyprland' 'xdg-desktop-portal-termfilechooser'
         'python' 'python-gobject')
# Yazi's own plugins, at the commit they were tried at: the mount manager comes from them
_plugins=1ef5fe02a6122f8f3bb47a41056aab3f4b8598bf
source=('yazi.toml' 'keymap.toml' 'init.lua' 'file-picker' 'termfilechooser.conf' 'portals.conf'
        'show-in-folder' 'org.freedesktop.FileManager1.service' 'open-folder' 'udiskie.yml'
        "yazi-plugins-$_plugins.tar.gz::https://github.com/yazi-rs/plugins/archive/$_plugins.tar.gz")
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP'
            'f2808f0ff5851cde839c3f36a3e038647449ad102b1c97b9b775a0670f186038')

package() {
  # Yazi reads its settings from the user's folder only, so they start there
  local file
  for file in yazi.toml keymap.toml init.lua; do
    install -Dm644 "$file" "$pkgdir/etc/skel/.config/yazi/$file"
  done
  cp -r "$startdir/plugins" "$pkgdir/etc/skel/.config/yazi/"
  # the mount manager, as its authors wrote it
  cp -r "$srcdir/plugins-$_plugins/mount.yazi" "$pkgdir/etc/skel/.config/yazi/plugins/"
  chmod -R u=rwX,go=rX "$pkgdir/etc/skel"

  install -Dm755 file-picker "$pkgdir/usr/lib/kavat/file-picker"
  install -Dm644 termfilechooser.conf "$pkgdir/etc/xdg/xdg-desktop-portal-termfilechooser/config"
  install -Dm644 portals.conf "$pkgdir/etc/xdg/xdg-desktop-portal/hyprland-portals.conf"
  install -Dm755 open-folder "$pkgdir/usr/lib/kavat/open-folder"
  install -Dm644 udiskie.yml "$pkgdir/usr/share/kavat/udiskie.yml"
  install -Dm755 show-in-folder "$pkgdir/usr/lib/kavat/show-in-folder"
  install -Dm644 org.freedesktop.FileManager1.service "$pkgdir/usr/share/dbus-1/services/org.freedesktop.FileManager1.service"
}
