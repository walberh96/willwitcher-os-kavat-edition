        [[ -z "${_git_email:-}"  ]]
@@ -9655,6 +9667,22 @@
 #
 # NOTE: Themes are loaded separately.
 __load_plugins() {
+  # Willwitcher-OS Kavat Edition: the system's own plugins come first, from the
+  # kavat-notes package; a user's plugin of the same name takes their place.
+  if [[ -d "/usr/share/kavat/nb/plugins" ]]
+  then
+    set +f
+    local __system_file=
+    for   __system_file in /usr/share/kavat/nb/plugins/*."${_ME}"-plugin
+    do
+      [[ -f "${__system_file}"                                    ]] || continue
+      [[ -f "${NB_DIR}/.plugins/${__system_file##*/}"             ]] && continue
+
+      source "${__system_file}" 2>/dev/null || :
+    done
+    set -f
+  fi
+
   if [[ -d "${NB_DIR}/.plugins" ]]
   then
     set +f
