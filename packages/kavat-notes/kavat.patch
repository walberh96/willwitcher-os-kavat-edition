--- a/nb	2026-11-14 16:46:55.121285588 -0500
+++ b/nb	2026-11-14 17:32:39.325400242 -0500
@@ -473,7 +473,18 @@
 # Default: `$HOME/.nb`
 #
 # The location of the directory that contains the notebooks.
-export NB_DIR="${NB_DIR:-"${HOME}/.${_ME}"}"
+# Willwitcher-OS Kavat Edition: git wants a name to keep the history under. Until
+# the user gives git one, the notes are kept under the user's own name, for nb
+# only: git's settings are not written.
+if ! git config user.name > /dev/null 2>&1 || ! git config user.email > /dev/null 2>&1
+then
+  export GIT_CONFIG_COUNT=2
+  export GIT_CONFIG_KEY_0=user.name   GIT_CONFIG_VALUE_0="${USER:-$(id -un)}"
+  export GIT_CONFIG_KEY_1=user.email  GIT_CONFIG_VALUE_1="${USER:-$(id -un)}@localhost"
+fi
+
+# Willwitcher-OS Kavat Edition: the notes live in ~/Notes, in plain sight.
+export NB_DIR="${NB_DIR:-"${HOME}/Notes"}"
 
 # Handle symlinked NB_DIR.
 if [[ -L "${NB_DIR:-}"      ]]
@@ -764,7 +775,8 @@
 # Default: value of $EDITOR or $VISUAL
 #
 # Example Values: 'vim', `code`'
-NB_EDITOR="${NB_EDITOR:-${EDITOR:-${VISUAL:-}}}"
+# Willwitcher-OS Kavat Edition: with no editor named, the system's is used.
