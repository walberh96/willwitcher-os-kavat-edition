# Part of kavat-base: puts the system's firewall up before the network comes up.
[Unit]
Description=The system's firewall: everything incoming closed
Wants=network-pre.target
Before=network-pre.target shutdown.target
Conflicts=shutdown.target
DefaultDependencies=no

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/nft -f /usr/share/kavat/firewall.nft
ExecStop=/usr/bin/nft delete table inet kavat_firewall

[Install]
WantedBy=sysinit.target
