#!/usr/bin/env python3
"""kavat-displays: arrange the displays, and keep one arrangement for each set of them.

usage: kavat-displays                          each display: its name, what it is, how it is set, and its workspaces
       kavat-displays modes <display>          the sizes and rates a display can show
       kavat-displays set <display> <setting>=<value>...
                                               mode=2560x1440@144  scale=1.25  rotate=0|90|180|270
                                               at=0x0, or at=right-of:<display>, left-of:, above:, below:
       kavat-displays place <display> <x> <y>  put a display near there, as dragging it does: it ends
                                               against the nearest edge of another, over none of them
       kavat-displays workspaces <display> <numbers>
                                               the workspaces that open on a display, from 1 to 10, as 1,2,3; `none`
                                               leaves the display with the ones nobody else has
       kavat-displays keep                     keep the arrangement in view: without it, a change is undone in 10 seconds
       kavat-displays undo                     go back to the arrangement from before the last change
       kavat-displays restore                  at the start of a session: wear the arrangement kept for the displays connected
       kavat-displays night                    the night light: off, on or auto; its warmth; and the hours it is on by itself
       kavat-displays night off|on|auto        auto turns it on between its two hours
       kavat-displays night warmth <2500-6500> the colour's temperature while it is on: lower is warmer
       kavat-displays night hours <HH:MM> <HH:MM>
                                               from when to when auto has it on

The arrangements live in ~/.config/hypr/monitors.lua, a table Hyprland's configuration
reads: one arrangement for each set of displays, the set known by what the displays are,
their make, model and serial number, and not by the socket they are plugged into. A change
is tried first: it is written, Hyprland reads its configuration again, and unless
`kavat-displays keep` comes within ten seconds the file from before is put back. The
workspaces of a display are not tried: they cannot leave a display black, so they stay.
The night light is hyprsunset, which this starts and stops as a service of the session; what
is set is in ~/.config/kavat/night.json, and the file hyprsunset reads is written from it.
"""
import json
import os
import re
import subprocess
import sys
import time

HOME = os.path.expanduser('~')
CONFIG = os.environ.get('XDG_CONFIG_HOME') or f'{HOME}/.config'
FILE = f'{CONFIG}/hypr/monitors.lua'
RUNTIME = os.environ.get('XDG_RUNTIME_DIR') or f'/run/user/{os.getuid()}'
PENDING = f'{RUNTIME}/kavat-displays-before.lua'  # the file from before a change that is being tried
SECONDS = 10
ROTATIONS = {'0': 0, '90': 1, '180': 2, '270': 3}


def hyprctl(*arguments):
    for instance in ([], ['--instance', '0']):
        try:
            done = subprocess.run(['hyprctl', *instance, *arguments], capture_output=True, text=True, timeout=10, check=False)
        except (OSError, subprocess.TimeoutExpired):
            return ''
        if done.returncode == 0 and 'HYPRLAND_INSTANCE_SIGNATURE' not in done.stdout:
            return done.stdout
    return ''


def displays():
    try:
        return json.loads(hyprctl('monitors', 'all', '-j') or '[]')
    except ValueError:
        return []


def what(display):
    """What a display is, wherever it is plugged in."""
    return display.get('description') or display['name']


def set_of(found):
    return ' + '.join(sorted(what(display) for display in found))


# ---- the file: a Lua table, written and read here

def read_file():
    """{'active': set, 'sets': {set: [rule, ...]}} from the file; empty when there is none."""
    try:
        text = open(FILE, encoding='utf-8').read()
    except OSError:
        return {'active': '', 'sets': {}}
    kept = {'active': '', 'sets': {}}
    active = re.search(r'^\s*active = "((?:[^"\\]|\\.)*)"', text, re.M)
    if active:
        kept['active'] = active.group(1).replace('\\"', '"')
    for name, body in re.findall(r'^\s*\["((?:[^"\\]|\\.)*)"\] = \{\n(.*?)^\s*\},\n', text, re.M | re.S):
        rules = []
        for line in body.splitlines():
            fields = {key: value.replace('\\"', '"').replace('\\\\', '\\')
                      for key, value in re.findall(r'(\w+) = "((?:[^"\\]|\\.)*)"', line)}
            fields.update({key: float(value) if '.' in value else int(value) for key, value in re.findall(r'(\w+) = (-?[\d.]+)', line)})
            if 'output' in fields:
                rules.append(fields)
        kept['sets'][name.replace('\\"', '"')] = rules
    return kept


def write_file(kept):
    def quoted(text):
        return '"' + str(text).replace('\\', '\\\\').replace('"', '\\"') + '"'
    lines = ['-- Written by kavat-displays: the arrangement of the displays, one for each set of them.',
             '-- It is changed on the Displays page of the settings, or with kavat-displays; by hand too,',
             '-- keeping one display to a line. Hyprland wears the set named in `active`.',
             'return {', f'  active = {quoted(kept["active"])},', '  sets = {']
    for name, rules in kept['sets'].items():
        lines.append(f'    [{quoted(name)}] = {{')
        for rule in rules:
            lines.append('      { ' + ', '.join(f'{key} = {quoted(rule[key]) if isinstance(rule[key], str) else rule[key]}'
                                                for key in ('output', 'mode', 'position', 'scale', 'transform', 'workspaces') if key in rule) + ' },')
        lines.append('    },')
    lines += ['  },', '}']
    os.makedirs(os.path.dirname(FILE), exist_ok=True)
    with open(FILE + '.new', 'w', encoding='utf-8') as file:
        file.write('\n'.join(lines) + '\n')
    os.replace(FILE + '.new', FILE)


def rule_of(display):
    """A display as it is now, as a rule of the file."""
    return {'output': 'desc:' + display['description'] if display.get('description') else display['name'],
            'mode': f'{display["width"]}x{display["height"]}@{display["refreshRate"]:.2f}',
            'position': f'{display["x"]}x{display["y"]}', 'scale': round(display['scale'], 2), 'transform': display.get('transform', 0)}


def size_of(rule):
    """The room a display takes in the arrangement: its size, turned and scaled."""
    width, height = (int(n) for n in re.match(r'(\d+)x(\d+)', rule['mode']).groups())
    if rule.get('transform', 0) % 2:
        width, height = height, width
    return round(width / rule.get('scale', 1)), round(height / rule.get('scale', 1))


def place_of(rule):
    return tuple(int(n) for n in re.match(r'(-?\d+)x(-?\d+)', rule['position']).groups())


def settle(current, moved, x, y):
    """Where a display dropped at x, y ends: against the nearest edge of another display,
    over none of them, with its edges lined up with its neighbour's when they are close.
    Then the whole arrangement is moved so that it starts at 0x0."""
    width, height = size_of(current[moved])
    others = [(place_of(rule), size_of(rule)) for name, rule in current.items() if name != moved]

    def over(at):
        return any(at[0] < ox + ow and ox < at[0] + width and at[1] < oy + oh and oy < at[1] + height
                   for (ox, oy), (ow, oh) in others)

    def lined(value, size, start, length):
        """A place along an edge: kept on the neighbour, and lined up with it when close."""
        value = max(start - size + 1, min(start + length - 1, value))
        for line in (start, start + length - size, start + (length - size) // 2):
            if abs(value - line) <= max(size, length) * 0.08:
                return line
        return value

    choices = []
    for (ox, oy), (ow, oh) in others:
        choices += [(ox + ow, lined(y, height, oy, oh)), (ox - width, lined(y, height, oy, oh)),
                    (lined(x, width, ox, ow), oy + oh), (lined(x, width, ox, ow), oy - height)]
    free = [at for at in choices if not over(at)]
    if free:
        x, y = min(free, key=lambda at: (at[0] - x) ** 2 + (at[1] - y) ** 2)
    current[moved]['position'] = f'{x}x{y}'
    left = min(place_of(rule)[0] for rule in current.values())
    top = min(place_of(rule)[1] for rule in current.values())
    for rule in current.values():
        at = place_of(rule)
        rule['position'] = f'{at[0] - left}x{at[1] - top}'


def reload():
    hyprctl('reload')


def numbers(rule):
    """The workspaces a rule gives its display, in order."""
    return [int(number) for number in re.findall(r'\d+', str(rule.get('workspaces', '')))]


def current_rules(kept, found):
    """The set of displays connected, as the file has it, or as the displays are now."""
    rules = {rule['output']: rule for rule in kept['sets'].get(set_of(found), [])}
    return {display['name']: dict(rules.get(rule_of(display)['output'], rule_of(display))) for display in found}


# ---- the night light

NIGHT = f'{CONFIG}/kavat/night.json'
SUNSET = f'{CONFIG}/hypr/hyprsunset.conf'


def night():
    kept = {'state': 'off', 'warmth': 4000, 'from': '20:00', 'to': '07:00'}
    try:
        with open(NIGHT, encoding='utf-8') as file:
            kept.update({key: value for key, value in json.load(file).items() if key in kept})
    except (OSError, ValueError, AttributeError):
        pass
    return kept


def night_wear(kept, save=True):
    if save:
        os.makedirs(os.path.dirname(NIGHT), exist_ok=True)
        with open(NIGHT + '.new', 'w', encoding='utf-8') as file:
            json.dump(kept, file, indent=2)
            file.write('\n')
        os.replace(NIGHT + '.new', NIGHT)
    if kept['state'] == 'off':
        subprocess.run(['systemctl', '--user', 'stop', 'hyprsunset.service'], capture_output=True, check=False)
        return
    warm = f'profile {{\n    time = %s\n    temperature = {kept["warmth"]}\n}}\n'
    plain = 'profile {\n    time = %s\n    identity = true\n}\n'
    text = '# Written by kavat-displays night: what is set is in ~/.config/kavat/night.json\n\n'
    text += warm % '0:00' if kept['state'] == 'on' else plain % kept['to'] + '\n' + warm % kept['from']
    os.makedirs(os.path.dirname(SUNSET), exist_ok=True)
    with open(SUNSET, 'w', encoding='utf-8') as file:
        file.write(text)
    done = subprocess.run(['systemctl', '--user', 'restart', 'hyprsunset.service'], capture_output=True, text=True, check=False)
    if done.returncode != 0:
        sys.exit('kavat-displays: the night light could not be started: ' + (done.stderr.strip().splitlines() or ['hyprsunset is missing'])[-1])


def main():
    arguments = sys.argv[1:]
    found = [display for display in displays() if not display.get('disabled')]
    by_name = {display['name']: display for display in found}
    if not arguments:
        kept_now = read_file()
        for display in found:
            rule = rule_of(display)
            own = current_rules(kept_now, found)[display['name']]
            print(f'{display["name"]}\t{what(display)}\t{rule["mode"]}\t{rule["position"]}\t{rule["scale"]}\t{rule["transform"] * 90}'
                  f'\t{",".join(str(number) for number in numbers(own)) or "-"}')
    elif arguments[0] == 'modes' and len(arguments) == 2 and arguments[1] in by_name:
        seen = dict.fromkeys(mode.replace('Hz', '') for mode in by_name[arguments[1]].get('availableModes', []))
        print('\n'.join(seen))
    elif (arguments[0] == 'set' and len(arguments) >= 3 and arguments[1] in by_name) or \
            (arguments[0] == 'place' and len(arguments) == 4 and arguments[1] in by_name
             and all(re.fullmatch(r'-?\d+', number) for number in arguments[2:])):
        kept = read_file()
        name = set_of(found)
        # the set as it is now, with what the file already says of it
        current = current_rules(kept, found)
        rule = current[arguments[1]]
        if arguments[0] == 'place':
            settle(current, arguments[1], int(arguments[2]), int(arguments[3]))
        for pair in arguments[2:] if arguments[0] == 'set' else []:
            key, _, value = pair.partition('=')
            if key == 'mode' and re.fullmatch(r'\d+x\d+(@[\d.]+)?', value):
                rule['mode'] = value
            elif key == 'scale' and re.fullmatch(r'[0-9.]+', value) and 0.5 <= float(value) <= 4:
                rule['scale'] = float(value)
            elif key == 'rotate' and value in ROTATIONS:
                rule['transform'] = ROTATIONS[value]
            elif key == 'at' and re.fullmatch(r'-?\d+x-?\d+', value):
                rule['position'] = value
            elif key == 'at' and re.fullmatch(r'(right-of|left-of|above|below):.+', value) and value.split(':', 1)[1] in current \
                    and value.split(':', 1)[1] != arguments[1]:
                side, other = value.split(':', 1)
                x, y = (int(n) for n in re.match(r'(-?\d+)x(-?\d+)', current[other]['position']).groups())
                other_width, other_height = size_of(current[other])
                width, height = size_of(rule)
                rule['position'] = {'right-of': f'{x + other_width}x{y}', 'left-of': f'{x - width}x{y}',
                                    'above': f'{x}x{y - height}', 'below': f'{x}x{y + other_height}'}[side]
            else:
                sys.exit(f'kavat-displays: {pair} is not something a display can be set to\n\n' + __doc__)
        # the file from before is kept aside until the change is kept or undone
        if not os.path.exists(PENDING):
            with open(PENDING, 'w', encoding='utf-8') as file:
                try:
                    file.write(open(FILE, encoding='utf-8').read())
                except OSError:
                    pass
        kept['sets'][name] = list(current.values())
        kept['active'] = name
        write_file(kept)
        reload()
        # unless it is kept, it is undone: a display left black by a mode it cannot show comes back by itself
        stamp = str(time.time())
        with open(PENDING + '.stamp', 'w', encoding='utf-8') as file:
            file.write(stamp)
        subprocess.Popen(['sh', '-c', f'sleep {SECONDS}; [ "$(cat "$1.stamp" 2> /dev/null)" = "$2" ] && exec "$0" undo', sys.argv[0], PENDING, stamp],
                         start_new_session=True, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        print(f'kavat-displays: `kavat-displays keep` within {SECONDS} seconds keeps it.')
    elif arguments[0] == 'workspaces' and len(arguments) == 3 and arguments[1] in by_name \
            and (arguments[2] == 'none' or re.fullmatch(r'\d+(,\d+)*', arguments[2])):
        wanted = [] if arguments[2] == 'none' else sorted({int(number) for number in arguments[2].split(',')})
        if any(not 1 <= number <= 10 for number in wanted):
            sys.exit('kavat-displays: the workspaces go from 1 to 10')
        kept = read_file()
        name = set_of(found)
        current = current_rules(kept, found)
        for display, rule in current.items():
            # a workspace is on one display: what this one takes, the others give up
            mine = wanted if display == arguments[1] else [number for number in numbers(rule) if number not in wanted]
            if mine:
                rule['workspaces'] = ' '.join(str(number) for number in mine)
            else:
                rule.pop('workspaces', None)
        kept['sets'][name] = list(current.values())
        kept['active'] = name
        write_file(kept)
        # a change of display being tried goes on being tried, with this in it
        reload()
        # the workspaces that are open move to their display now; the rest open there
        for display, rule in current.items():
            for number in numbers(rule):
                hyprctl('dispatch', f'hl.dsp.workspace.move({{ workspace = {number}, monitor = "{display}" }})')
    elif arguments == ['keep']:
        for path in (PENDING, PENDING + '.stamp'):
            try:
                os.remove(path)
            except OSError:
                pass
    elif arguments == ['undo']:
        if os.path.exists(PENDING):
            before = open(PENDING, encoding='utf-8').read()
            if before:
                with open(FILE, 'w', encoding='utf-8') as file:
                    file.write(before)
            else:
                os.remove(FILE)
            for path in (PENDING, PENDING + '.stamp'):
                try:
                    os.remove(path)
                except OSError:
                    pass
            reload()
    elif arguments == ['night']:
        kept = night()
        print('\t'.join((kept['state'], str(kept['warmth']), kept['from'], kept['to'])))
    elif arguments[0] == 'night' and arguments[1:] in (['off'], ['on'], ['auto']):
        night_wear({**night(), 'state': arguments[1]})
    elif arguments[:2] == ['night', 'warmth'] and len(arguments) == 3 and arguments[2].isdigit() and 2500 <= int(arguments[2]) <= 6500:
        night_wear({**night(), 'warmth': int(arguments[2])})
    elif arguments[:2] == ['night', 'hours'] and len(arguments) == 4 and all(re.fullmatch(r'([01]\d|2[0-3]):[0-5]\d', hour) for hour in arguments[2:]) \
            and arguments[2] != arguments[3]:
        night_wear({**night(), 'from': arguments[2], 'to': arguments[3]})
    elif arguments == ['night', 'restore']:
        night_wear(night(), save=False)
    elif arguments == ['restore']:
        kept = read_file()
        name = set_of(found)
        if name in kept['sets'] and kept['active'] != name:
            kept['active'] = name
            write_file(kept)
            reload()
    else:
        sys.exit(__doc__)


if __name__ == '__main__':
    main()
