pkgname=kavat-shell
pkgver=5.4.1
pkgrel=4
pkgdesc="Willwitcher-OS Kavat Edition: Kavat Shell, the desktop shell; it began as Noctalia and asks the network for nothing by itself"
arch=('x86_64')
url='https://github.com/walberh96/willwitcher-os-kavat-edition'
# Noctalia is MIT, and so is what this package changes in it
license=('MIT')
# It began as Noctalia 5.4.1 and is the system's own program now, with its own name: the
# command is kavat-shell. The two can be installed side by side, since no file is shared.
# The dependencies and the build are Arch's own recipe for Noctalia 5.4.1; python runs the
# renaming.
depends=(
  'bash'
  'cairo'
  'curl'
  'fontconfig'
  'freetype2'
  'git'
  'glib2'
  'glibc'
  'harfbuzz'
  'hicolor-icon-theme'
  'jemalloc'
  'libgcc'
  'libglvnd'
  'libical'
  'libjxl'
  'libpipewire'
  'libqalculate'
  'librsvg'
  'libsecret'
  'libsndfile'
  'libsodium'
  'libstdc++'
  'libwebp'
  'libwireplumber'
  'libxkbcommon'
  'libxml2'
  'md4c'
  'pam'
  'polkit'
  'pango'
  'sdbus-cpp'
  'tomlplusplus'
  'wayland'
)
optdepends=(
  'ddcutil: monitor brightness control'
  'power-profiles-daemon: power profile management'
  'upower: battery and power device integration'
)

makedepends=(
  'meson'
  'ninja'
  'nlohmann-json'
  'pkgconf'
  'stb'
  'wayland-protocols'
)
source=("noctalia-$pkgver.tar.gz::https://github.com/noctalia-dev/noctalia/archive/refs/tags/v$pkgver.tar.gz"
        'no-ping.patch' 'no-network.patch' 'arrange.patch' 'no-first-wallpaper.patch' 'rename.py')
sha256sums=('6069d922e9d72488c74e4ce335314ce2203f08bd4641380bfe1bd137004597fa'
            'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP')
options=('!debug')

# What the fork changes, in this order:
#   no-ping.patch      Noctalia's "anonymous startup ping" is gone: the code that sent it, its
#                      switch in the settings and the offer of it in the first-run dialog.
#   no-network.patch   nothing is fetched from the network unless it is asked for: the lists
#                      of plugins, the community's palettes and templates, exchange rates and
#                      the weather are off until turned on, and covers and notification
#                      icons that are on the network are not fetched at all.
#   arrange.patch      one more control for plugins, ui.arrange: rectangles drawn to scale
#                      that are placed by dragging them, their edges snapping to each
#                      other. The Displays page of the settings is made with it.
#   no-first-wallpaper.patch
#                      the picture Noctalia shows as the background until one is chosen
#                      is never shown: the background is the theme's from the first frame.
#   rename.py          the name: the command, the folders, the D-Bus names and every text.
prepare() {
  cd "noctalia-$pkgver"
  patch -p1 < "$srcdir/no-ping.patch"
  patch -p1 < "$srcdir/no-network.patch"
  patch -p1 < "$srcdir/arrange.patch"
  patch -p1 < "$srcdir/no-first-wallpaper.patch"
  python "$srcdir/rename.py" .
}

build() {
  CXXFLAGS+=" -Wno-unused-result"
  arch-meson "noctalia-$pkgver" build-release \
    -Db_ndebug=true \
    -Dtests=disabled
  meson compile -C build-release
  for shell in bash fish zsh; do
    build-release/kavat-shell completions "$shell" > "${shell}-completion"
  done
}

package() {
  meson install -C build-release --destdir "$pkgdir"

  install -Dm644 "noctalia-$pkgver/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 bash-completion "$pkgdir/usr/share/bash-completion/completions/kavat-shell"
  install -Dm644 fish-completion "$pkgdir/usr/share/fish/vendor_completions.d/kavat-shell.fish"
  install -Dm644 zsh-completion "$pkgdir/usr/share/zsh/site-functions/_kavat-shell"
}
