+    // Kavat Shell: every setting the shell has, as data, for the settings of the system to
+    // draw them as its own pages. One object for each control of the shell's settings: the
+    // section and the group it is in, its name and what it says, the path it is kept at in
+    // the configuration, what kind of control it is, its value and what it may be. A control
+    // that is not a plain value, a list of actions or a store of plugins, is named and left
+    // without a value.
+    nlohmann::json optionsJson(const std::vector<settings::SelectOption>& options) {
+      auto out = nlohmann::json::array();
+      for (const auto& option : options) {
+        out.push_back({{"value", option.value}, {"label", option.label}});
+      }
+      return out;
+    }
+
+    int runSettingsList() {
+      setLogLevel(LogLevel::Warn);
+      ConfigService configService;
+      const Config& cfg = configService.config();
+      i18n::Service::instance().init("en");
+      settings::RegistryEnvironment env;
+      const BarConfig* bar = settings::findBar(cfg, "default");
+      if (bar == nullptr && !cfg.bars.empty()) {
+        bar = &cfg.bars.front();
+      }
+      const std::vector<settings::SettingEntry> registry = settings::buildSettingsRegistry(cfg, bar, nullptr, env);
+
+      auto out = nlohmann::json::array();
+      for (const auto& entry : registry) {
+        std::string path;
+        for (const auto& part : entry.path) {
+          if (!path.empty()) {
+            path += '.';
+          }
+          path += part;
+        }
+        nlohmann::json item = {
+            {"section", std::string(settings::settingsSectionId(entry.section))},
+            {"section_label", i18n::tr(settings::settingsSectionLabelKey(entry.section))},
+            {"group", entry.group},
+            {"group_label", i18n::tr("settings.navigation.groups." + entry.group)},
+            {"title", entry.title},
+            {"about", entry.subtitle},
+            {"path", path},
+            {"advanced", entry.advanced},
+            {"visible", passesVisibility(cfg, entry)},
+        };
+        std::visit(
+            [&item](const auto& control) {
+              using T = std::decay_t<decltype(control)>;
+              if constexpr (std::is_same_v<T, settings::ToggleSetting>) {
+                item["kind"] = "toggle";
+                item["value"] = control.checked;
+                item["enabled"] = control.enabled;
+              } else if constexpr (std::is_same_v<T, settings::SelectSetting>) {
+                item["kind"] = "select";
+                item["value"] = control.selectedValue;
+                item["options"] = optionsJson(control.options);
+                item["segmented"] = control.segmented;
+                item["type"] = control.valueType == settings::SelectValueType::Integer
+                    ? "integer"
+                    : control.valueType == settings::SelectValueType::Boolean ? "boolean" : "string";
+                item["linked"] = static_cast<bool>(control.groupedCommit);
+              } else if constexpr (std::is_same_v<T, settings::SliderSetting>) {
+                item["kind"] = "slider";
+                item["value"] = control.value;
+                item["min"] = control.minValue;
+                item["max"] = control.maxValue;
+                item["step"] = control.step;
+                item["integer"] = control.integerValue;
+                item["suffix"] = control.valueSuffix;
+                item["linked"] = static_cast<bool>(control.linkedCommit)
+                    || control.invertSlot == settings::SliderSetting::InvertSlot::Toggle;
+              } else if constexpr (std::is_same_v<T, settings::StepperSetting>) {
+                item["kind"] = "slider";
+                item["value"] = control.value;
+                item["min"] = control.minValue;
+                item["max"] = control.maxValue;
+                item["step"] = control.step;
+                item["integer"] = true;
+                item["suffix"] = control.valueSuffix;
+              } else if constexpr (std::is_same_v<T, settings::OptionalStepperSetting>) {
+                item["kind"] = "optional-number";
+                item["value"] = control.value ? nlohmann::json(*control.value) : nlohmann::json(nullptr);
+                item["min"] = control.minValue;
+                item["max"] = control.maxValue;
+                item["step"] = control.step;
+                item["integer"] = true;
+                item["unset"] = control.unsetLabel;
+                item["fallback"] = control.fallbackValue;
+              } else if constexpr (std::is_same_v<T, settings::OptionalNumberSetting>) {
+                item["kind"] = "optional-number";
+                item["value"] = control.value ? nlohmann::json(*control.value) : nlohmann::json(nullptr);
+                item["min"] = control.minValue;
+                item["max"] = control.maxValue;
+                item["integer"] = false;
+                item["unset"] = control.placeholder;
+              } else if constexpr (std::is_same_v<T, settings::TextSetting>) {
+                item["kind"] = "text";
+                item["value"] = control.value;
+                item["placeholder"] = control.placeholder;
+              } else if constexpr (std::is_same_v<T, settings::MultiSelectSetting>) {
+                item["kind"] = "multi";
+                item["value"] = control.selectedValues;
+                item["options"] = optionsJson(control.options);
+                item["at_least_one"] = control.requireAtLeastOne;
+                item["keeps_unselected"] = control.persistUnselected;
+              } else if constexpr (std::is_same_v<T, settings::ListSetting>) {
+                item["kind"] = "list";
+                item["value"] = control.items;
+                item["options"] = optionsJson(control.suggestedOptions);
+              } else if constexpr (std::is_same_v<T, settings::SearchPickerSetting>) {
+                item["kind"] = control.onSelect ? "other" : "select";
+                item["value"] = control.selectedValue;
+                item["options"] = optionsJson(control.options);
+                item["type"] = "string";
+              } else if constexpr (std::is_same_v<T, settings::ColorSpecPickerSetting>) {
+                item["kind"] = "color";
+                item["value"] = control.selectedValue;
+                item["none"] = control.allowNone;
+              } else {
+                item["kind"] = "other";
+              }
+            },
+            entry.control
+        );
+        out.push_back(std::move(item));
+      }
+      std::println("{}", out.dump());
+      return 0;
+    }
