+    // The settings of one widget of the bar, by the name it has in the configuration, the
+    // same way: `kavat-shell config settings-list widget clock`.
+    int runWidgetSettingsList(const std::string& widget) {
+      setLogLevel(LogLevel::Warn);
+      ConfigService configService;
+      const Config& cfg = configService.config();
+      i18n::Service::instance().init("en");
+      const std::string type = settings::widgetTypeForReference(cfg, widget);
+      const auto found = cfg.widgets.find(widget);
+      const WidgetConfig* config = found != cfg.widgets.end() ? &found->second : nullptr;
+      const std::vector<settings::WidgetSettingSpec> specs =
+          settings::widgetSettingSpecs(type, config, cfg.shell.fontFamily, false);
+
+      auto out = nlohmann::json::array();
+      for (const auto& spec : specs) {
+        if (!spec.visibleInInspector) {
+          continue;
+        }
+        const WidgetSettingValue* now = config != nullptr ? config->findSetting(spec.schema.key) : nullptr;
+        const WidgetSettingValue& value = now != nullptr ? *now : spec.schema.defaultValue;
+        nlohmann::json plain = std::visit(
+            [](const auto& held) -> nlohmann::json {
+              using T = std::decay_t<decltype(held)>;
+              if constexpr (std::is_same_v<T, WidgetSettingStringMap>) {
+                auto map = nlohmann::json::object();
+                for (const auto& [key, text] : held) {
+                  map[key] = text;
+                }
+                return map;
+              } else {
+                return held;
+              }
+            },
+            value
+        );
+        std::string about = spec.literalDescription;
+        if (about.empty() && !spec.descriptionKey.empty()) {
+          about = i18n::tr(spec.descriptionKey);
+        }
+        nlohmann::json item = {
+            {"section", "widget"},
+            {"section_label", "Widget"},
+            {"group", spec.group},
+            {"group_label", i18n::tr("settings.entities.widget.settings.groups." + spec.group)},
+            {"title", spec.literalLabel.empty() ? i18n::tr(spec.labelKey) : spec.literalLabel},
+            {"about", about},
+            {"path", "widget." + widget + "." + spec.schema.key},
+            {"advanced", spec.advanced},
+            {"visible", settings::widgetSettingIsVisible(cfg, widget, spec, specs, settings::WidgetSettingCapabilities{})},
+            {"value", plain},
+        };
+        const bool bounded = spec.schema.minValue.has_value() && spec.schema.maxValue.has_value();
+        switch (spec.control) {
+        case settings::WidgetControlKind::Bool:
+          item["kind"] = "toggle";
+          break;
+        case settings::WidgetControlKind::Int:
+        case settings::WidgetControlKind::Double:
+          item["kind"] = bounded ? "slider" : "number";
+          item["integer"] = spec.control == settings::WidgetControlKind::Int;
+          if (spec.schema.minValue) {
+            item["min"] = *spec.schema.minValue;
+          }
+          if (spec.schema.maxValue) {
+            item["max"] = *spec.schema.maxValue;
+          }
+          item["step"] = spec.schema.step.value_or(spec.control == settings::WidgetControlKind::Int ? 1.0 : 0.05);
+          item["suffix"] = spec.valueSuffix;
+          break;
+        case settings::WidgetControlKind::OptionalDouble:
+          item["kind"] = "optional-number";
+          item["integer"] = false;
+          if (spec.schema.minValue) {
+            item["min"] = *spec.schema.minValue;
+          }
+          if (spec.schema.maxValue) {
+            item["max"] = *spec.schema.maxValue;
+          }
+          break;
+        case settings::WidgetControlKind::String:
+        case settings::WidgetControlKind::File:
+        case settings::WidgetControlKind::Folder:
+        case settings::WidgetControlKind::Glyph:
+          item["kind"] = "text";
+          break;
+        case settings::WidgetControlKind::StringList:
+          item["kind"] = "list";
+          item["options"] = nlohmann::json::array();
+          break;
+        case settings::WidgetControlKind::Select: {
+          item["kind"] = "select";
+          item["segmented"] = spec.segmented;
+          item["type"] = spec.integerValue ? "integer" : "string";
+          auto options = nlohmann::json::array();
+          for (const auto& option : spec.options) {
+            options.push_back(
+                {{"value", option.value},
+                 {"label", spec.literalLabels ? option.labelKey : i18n::tr(option.labelKey)}}
+            );
+          }
+          if (options.empty()) {
+            for (const auto& allowed : spec.schema.enumValues) {
+              options.push_back({{"value", allowed}, {"label", allowed}});
+            }
+          }
+          item["options"] = std::move(options);
+          if (plain.is_number_integer()) {
+            item["value"] = std::to_string(plain.get<std::int64_t>());
+          }
+          break;
+        }
+        case settings::WidgetControlKind::ColorSpec:
+          item["kind"] = "color";
+          break;
+        case settings::WidgetControlKind::StringMap:
+          item["kind"] = "other";
+          break;
+        }
+        out.push_back(std::move(item));
+      }
+      std::println("{}", out.dump());
+      return 0;
+    }
