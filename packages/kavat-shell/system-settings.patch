+// Kavat Shell: the shell is a piece of a system that has its settings in one place, a panel
+// of the system's own, where the shell's are too. Every door to the shell's settings, the
+// launcher's button, the control center's, a widget's and the commands, opens that panel
+// when it is there; the shell's own window is what opens when it is not.
+bool PanelManager::openSystemSettings(const std::string& context) {
+  static const std::string kSystemSettings = "kavat/settings:panel";
+  if (!m_panels.contains(kSystemSettings)) {
+    return false;
+  }
+  if (isOpen() && !m_closing && m_activePanelId == kSystemSettings) {
+    if (!context.empty() && m_activePanel != nullptr) {
+      m_activePanel->onOpen(context);
+      refresh();
+    }
+    return true;
+  }
+  openPanel(kSystemSettings, PanelOpenRequest{.context = context});
+  return true;
+}
+
 void PanelManager::openSettingsWindow(std::string context) {
+  if (openSystemSettings(context)) {
+    return;
+  }
   if (isOpen() && !m_closing) {
     closePanel();
   }
