+-- ui.arrange takes its rectangles as `items`, an array of tables. A prop holds a flat array
+-- of numbers or of strings and nothing deeper, so they cross to the host as parallel arrays;
+-- a position is two numbers and a callback carries two arguments, so onMove's comes as "x,y"
+-- and is split here.
+ui.arrange = function(props)
+  local out = {}
+  local keys, labels, sublabels, rects = {}, {}, {}, {}
+  for name, value in pairs(props or {}) do
+    if name ~= "items" then
+      out[name] = value
+    end
+  end
+  for i, item in ipairs(props and props.items or {}) do
+    keys[i] = tostring(item.key)
+    labels[i] = tostring(item.label or "")
+    sublabels[i] = tostring(item.sublabel or "")
+    local at = (i - 1) * 5
+    rects[at + 1] = tonumber(item.x) or 0
+    rects[at + 2] = tonumber(item.y) or 0
+    rects[at + 3] = tonumber(item.width) or 0
+    rects[at + 4] = tonumber(item.height) or 0
+    rects[at + 5] = item.selected and 1 or 0
+  end
+  out.itemKeys, out.itemLabels, out.itemSublabels, out.itemRects = keys, labels, sublabels, rects
+  local onMove = out.onMove
+  if type(onMove) == "function" then
+    out.onMove = function(key, position)
+      local x, y = string.match(position or "", "^(-?%d+),(-?%d+)$")
+      return onMove(key, x, y)
+    end
+  end
+  return { type = "arrange", props = out, children = {} }
+end
 )luau";
 
 } // namespace scripting
diff --color -ruN -x .git a/src/ui/controls/arrange.cpp b/src/ui/controls/arrange.cpp
--- a/src/ui/controls/arrange.cpp	1969-12-31 19:00:00.000000000 -0500
+++ b/src/ui/controls/arrange.cpp	2026-11-15 10:20:15.845917125 -0500
@@ -0,0 +1,336 @@
+#include "ui/controls/arrange.h"
+
+#include "ui/controls/box.h"
+#include "ui/controls/label.h"
+#include "ui/palette.h"
+#include "ui/style.h"
+
+#include <algorithm>
+#include <cmath>
+#include <limits>
+#include <memory>
+#include <utility>
+
+namespace {
+  // How close two edges come, in pixels before the content scale, before one snaps to the other.
+  constexpr float kSnapPixels = 10.0F;
+  // How far a press travels before it stops being a click and starts carrying the rectangle.
+  constexpr float kDragThresholdPixels = 4.0F;
+  constexpr float kSelectedBorderWidth = 2.0F;
+} // namespace
+
+Arrange::Arrange() {
+  setClipChildren(true);
+
+  auto background = std::make_unique<Box>();
+  background->setFill(colorSpecFromRole(ColorRole::SurfaceContainerLow));
+  background->setBorder(colorSpecFromRole(ColorRole::OutlineVariant), Style::borderWidth);
+  m_background = static_cast<Box*>(addChild(std::move(background)));
+
+  setOnPress([this](const PointerData& pointer) { onPointerPress(pointer); });
+  setOnMotion([this](const PointerData& pointer) { onPointerMotion(pointer); });
+  setOnCancel([this] { cancelDrag(); });
+}
+
+void Arrange::setScale(float scale, float fontScale) {
+  if (m_scale == scale && m_fontScale == fontScale) {
+    return;
+  }
+  m_scale = scale;
+  m_fontScale = fontScale;
+  for (std::size_t i = 0; i < m_visuals.size(); ++i) {
+    applyItemStyle(i);
+  }
+  markLayoutDirty();
+}
+
+void Arrange::setItems(std::vector<Item> items, bool force) {
+  if (!force && items == m_given) {
+    return;
+  }
+  m_given = items;
+  if (m_drag.has_value()) {
+    // The rectangle in the hand stays under the pointer; the position given for it is where
+    // a cancel takes it back to.
+    const Item& carried = m_items[m_drag->index];
+    const auto match = std::ranges::find(items, carried.key, &Item::key);
+    if (match == items.end()) {
+      m_drag.reset();
+    } else {
+      m_drag->index = static_cast<std::size_t>(match - items.begin());
+      m_drag->startX = match->x;
+      m_drag->startY = match->y;
+      match->x = carried.x;
+      match->y = carried.y;
+    }
+  }
+  m_items = std::move(items);
+  syncVisuals();
+  markLayoutDirty();
+}
+
+void Arrange::cancelDrag() {
+  if (!m_drag.has_value()) {
+    return;
+  }
+  Item& item = m_items[m_drag->index];
+  item.x = m_drag->startX;
+  item.y = m_drag->startY;
+  endDrag();
+}
+
+void Arrange::endDrag() {
+  if (m_drag.has_value() && m_drag->index < m_visuals.size()) {
+    m_visuals[m_drag->index].box->setZIndex(0);
+  }
+  m_drag.reset();
+  // The arrangement is fitted again around where the rectangle ended up.
+  markLayoutDirty();
+}
+
+void Arrange::onPointerPress(const PointerData& pointer) {
+  if (pointer.button != BTN_LEFT) {
+    return;
+  }
+  if (pointer.pressed) {
+    if (m_drag.has_value()) {
+      return;
+    }
+    const auto index = itemAt(pointer.localX, pointer.localY);
+    if (!index.has_value()) {
+      return;
+    }
+    const Item& item = m_items[*index];
+    m_drag = Drag{
+        .index = *index,
+        .startX = item.x,
+        .startY = item.y,
+        .grabX =
+            m_transform.unitX + static_cast<double>(pointer.localX - m_transform.originX) / m_transform.factor - item.x,
+        .grabY =
+            m_transform.unitY + static_cast<double>(pointer.localY - m_transform.originY) / m_transform.factor - item.y,
+        .pressX = pointer.localX,
+        .pressY = pointer.localY,
+    };
+    // Shown at once; the caller's next render confirms it.
+    for (std::size_t i = 0; i < m_items.size(); ++i) {
+      const bool selected = i == *index;
+      if (m_items[i].selected != selected) {
+        m_items[i].selected = selected;
+        applyItemStyle(i);
+      }
+    }
+    m_visuals[*index].box->setZIndex(1);
+    markPaintDirty();
+    if (m_onSelect) {
+      const std::string key = item.key;
+      m_onSelect(key);
+    }
+    return;
+  }
+
+  if (!m_drag.has_value()) {
+    return;
+  }
+  const bool moved = m_drag->moved;
+  Item& item = m_items[m_drag->index];
+  if (moved) {
+    item.x = std::round(item.x);
+    item.y = std::round(item.y);
+  }
+  const std::string key = item.key;
+  const auto x = static_cast<long long>(item.x);
+  const auto y = static_cast<long long>(item.y);
+  endDrag();
+  if (moved && m_onMove) {
+    m_onMove(key, x, y);
+  }
+}
+
+void Arrange::onPointerMotion(const PointerData& pointer) {
+  if (!m_drag.has_value()) {
+    return;
+  }
+  // The pointer is followed past the control's edge, pinned to it.
+  const float localX = std::clamp(pointer.localX, 0.0F, std::max(0.0F, width()));
+  const float localY = std::clamp(pointer.localY, 0.0F, std::max(0.0F, height()));
+  if (!m_drag->moved) {
+    if (std::hypot(localX - m_drag->pressX, localY - m_drag->pressY) < kDragThresholdPixels * m_scale) {
+      return;
+    }
+    m_drag->moved = true;
+  }
+  double x = m_transform.unitX + static_cast<double>(localX - m_transform.originX) / m_transform.factor - m_drag->grabX;
+  double y = m_transform.unitY + static_cast<double>(localY - m_transform.originY) / m_transform.factor - m_drag->grabY;
+  snap(m_drag->index, x, y);
+  Item& item = m_items[m_drag->index];
+  item.x = x;
+  item.y = y;
+  placeItem(m_drag->index);
+  markPaintDirty();
+}
+
+// Each axis takes the nearest of the other rectangles' edges within reach: side by side
+// (left to right, right to left, top to bottom, bottom to top) or aligned (left to left,
+// right to right, top to top, bottom to bottom).
+void Arrange::snap(std::size_t index, double& x, double& y) const {
+  const Item& item = m_items[index];
+  const double reach = static_cast<double>(kSnapPixels * m_scale) / m_transform.factor;
+  double bestX = std::numeric_limits<double>::infinity();
+  double bestY = std::numeric_limits<double>::infinity();
+  const auto consider = [reach](double delta, double& best) {
+    if (std::abs(delta) <= reach && std::abs(delta) < std::abs(best)) {
+      best = delta;
+    }
+  };
+  for (std::size_t i = 0; i < m_items.size(); ++i) {
+    if (i == index) {
+      continue;
+    }
+    const Item& other = m_items[i];
+    consider(other.x + other.width - x, bestX);
+    consider(other.x - (x + item.width), bestX);
+    consider(other.x - x, bestX);
+    consider(other.x + other.width - (x + item.width), bestX);
+    consider(other.y + other.height - y, bestY);
+    consider(other.y - (y + item.height), bestY);
+    consider(other.y - y, bestY);
+    consider(other.y + other.height - (y + item.height), bestY);
+  }
+  if (std::isfinite(bestX)) {
+    x += bestX;
+  }
+  if (std::isfinite(bestY)) {
+    y += bestY;
+  }
+}
+
+std::optional<std::size_t> Arrange::itemAt(float localX, float localY) const {
+  // The last one drawn is the one on top.
+  for (std::size_t i = m_visuals.size(); i-- > 0;) {
+    const Box* box = m_visuals[i].box;
+    if (localX >= box->x()
+        && localX < box->x() + box->width()
+        && localY >= box->y()
+        && localY < box->y() + box->height()) {
+      return i;
+    }
+  }
+  return std::nullopt;
+}
+
+void Arrange::syncVisuals() {
+  while (m_visuals.size() > m_items.size()) {
+    (void)removeChild(m_visuals.back().box);
+    m_visuals.pop_back();
+  }
+  while (m_visuals.size() < m_items.size()) {
+    Visual visual;
+    auto box = std::make_unique<Box>();
+    box->setFill(colorSpecFromRole(ColorRole::SurfaceContainerHigh));
+    auto label = std::make_unique<Label>();
+    label->setColor(colorSpecFromRole(ColorRole::OnSurface));
+    label->setMaxLines(1);
+    auto sublabel = std::make_unique<Label>();
+    sublabel->setColor(colorSpecFromRole(ColorRole::OnSurfaceVariant));
+    sublabel->setMaxLines(1);
+    visual.label = static_cast<Label*>(box->addChild(std::move(label)));
+    visual.sublabel = static_cast<Label*>(box->addChild(std::move(sublabel)));
+    visual.box = static_cast<Box*>(addChild(std::move(box)));
+    m_visuals.push_back(visual);
+  }
+  for (std::size_t i = 0; i < m_items.size(); ++i) {
+    m_visuals[i].label->setText(m_items[i].label);
+    m_visuals[i].sublabel->setText(m_items[i].sublabel);
+    m_visuals[i].box->setZIndex(m_drag.has_value() && m_drag->index == i ? 1 : 0);
+    applyItemStyle(i);
+  }
+}
+
+void Arrange::applyItemStyle(std::size_t index) {
+  const Visual& visual = m_visuals[index];
+  if (m_items[index].selected) {
+    visual.box->setBorder(colorSpecFromRole(ColorRole::Primary), kSelectedBorderWidth * m_scale);
+  } else {
+    visual.box->setBorder(colorSpecFromRole(ColorRole::OutlineVariant), Style::borderWidth);
+  }
+  visual.box->setRadius(Style::scaledRadiusMd(m_scale));
+  visual.label->setFontSize(Style::fontSizeBody * m_scale * m_fontScale);
+  visual.sublabel->setFontSize(Style::fontSizeMini * m_scale * m_fontScale);
+}
+
+Arrange::Transform Arrange::fitTransform() const {
+  Transform transform;
+  if (m_items.empty()) {
+    return transform;
+  }
+  double left = std::numeric_limits<double>::infinity();
+  double top = std::numeric_limits<double>::infinity();
+  double right = -std::numeric_limits<double>::infinity();
+  double bottom = -std::numeric_limits<double>::infinity();
+  for (const Item& item : m_items) {
+    left = std::min(left, item.x);
+    top = std::min(top, item.y);
+    right = std::max(right, item.x + item.width);
+    bottom = std::max(bottom, item.y + item.height);
+  }
+  const double margin = static_cast<double>(Style::spaceMd * m_scale);
+  const double roomX = std::max(1.0, static_cast<double>(width()) - margin * 2.0);
+  const double roomY = std::max(1.0, static_cast<double>(height()) - margin * 2.0);
+  const double spanX = std::max(1.0, right - left);
+  const double spanY = std::max(1.0, bottom - top);
+  transform.factor = std::min(roomX / spanX, roomY / spanY);
+  transform.unitX = left;
+  transform.unitY = top;
+  transform.originX = static_cast<float>((static_cast<double>(width()) - spanX * transform.factor) * 0.5);
+  transform.originY = static_cast<float>((static_cast<double>(height()) - spanY * transform.factor) * 0.5);
+  return transform;
+}
+
+void Arrange::placeItem(std::size_t index) {
+  const Item& item = m_items[index];
+  m_visuals[index].box->setPosition(
+      std::round(m_transform.originX + static_cast<float>((item.x - m_transform.unitX) * m_transform.factor)),
+      std::round(m_transform.originY + static_cast<float>((item.y - m_transform.unitY) * m_transform.factor))
+  );
+}
+
+void Arrange::doLayout(Renderer& renderer) {
+  m_background->setPosition(0.0F, 0.0F);
+  m_background->setFrameSize(width(), height());
+  m_background->setRadius(Style::scaledRadiusLg(m_scale));
+
+  if (!m_drag.has_value()) {
+    m_transform = fitTransform();
+  }
+  const float padding = Style::spaceXs * m_scale;
+  for (std::size_t i = 0; i < m_items.size(); ++i) {
+    const Item& item = m_items[i];
+    const Visual& visual = m_visuals[i];
+    const float boxWidth = std::max(1.0F, std::round(static_cast<float>(item.width * m_transform.factor)));
+    const float boxHeight = std::max(1.0F, std::round(static_cast<float>(item.height * m_transform.factor)));
+    visual.box->setFrameSize(boxWidth, boxHeight);
+    placeItem(i);
+
+    // The texts are centred as one block; what does not fit inside the rectangle is left out,
+    // the smaller line first.
+    const float textWidth = std::max(1.0F, boxWidth - padding * 2.0F);
+    visual.label->setMaxWidth(textWidth);
+    visual.label->measure(renderer);
+    visual.sublabel->setMaxWidth(textWidth);
+    visual.sublabel->measure(renderer);
+    const float room = boxHeight - padding * 2.0F;
+    const bool showLabel = !item.label.empty() && visual.label->height() <= room;
+    const bool showSublabel =
+        showLabel && !item.sublabel.empty() && visual.label->height() + visual.sublabel->height() <= room;
+    visual.label->setVisible(showLabel);
+    visual.sublabel->setVisible(showSublabel);
+    const float blockHeight = visual.label->height() + (showSublabel ? visual.sublabel->height() : 0.0F);
+    const float blockTop = std::round((boxHeight - blockHeight) * 0.5F);
+    visual.label->setPosition(std::round((boxWidth - visual.label->width()) * 0.5F), blockTop);
+    visual.sublabel->setPosition(
+        std::round((boxWidth - visual.sublabel->width()) * 0.5F), blockTop + visual.label->height()
+    );
+  }
+  InputArea::doLayout(renderer);
+}
diff --color -ruN -x .git a/src/ui/controls/arrange.h b/src/ui/controls/arrange.h
--- a/src/ui/controls/arrange.h	1969-12-31 19:00:00.000000000 -0500
+++ b/src/ui/controls/arrange.h	2026-11-15 10:18:29.704846983 -0500
@@ -0,0 +1,105 @@
+#pragma once
+
+#include "render/scene/input_area.h"
+
+#include <cstddef>
+#include <functional>
+#include <optional>
+#include <string>
+#include <vector>
+
+class Box;
+class Label;
+
+// Rectangles placed freely on a plane, drawn to scale and moved by dragging: the
+// arrangement of a set of displays, for one. Positions and sizes are in the caller's own
+// layout units; the control fits the whole arrangement inside its box with one scale
+// factor. A drag moves a rectangle with the pointer without leaving the control, its edges
+// snapping to the other rectangles' edges, and reports the new position once, on release.
+class Arrange final : public InputArea {
+public:
+  struct Item {
+    std::string key;
+    double x = 0.0;
+    double y = 0.0;
+    double width = 0.0;
+    double height = 0.0;
+    std::string label;
+    std::string sublabel;
+    bool selected = false;
+
+    bool operator==(const Item&) const = default;
+  };
