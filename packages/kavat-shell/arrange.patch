+          continue;
+        }
+        items.push_back(
+            Arrange::Item{
+                .key = (*keys)[i],
+                .x = rect[0],
+                .y = rect[1],
+                .width = rect[2],
+                .height = rect[3],
+                .label = labels != nullptr && i < labels->size() ? (*labels)[i] : std::string{},
+                .sublabel = sublabels != nullptr && i < sublabels->size() ? (*sublabels)[i] : std::string{},
+                .selected = rect[4] != 0.0,
+            }
+        );
+      }
