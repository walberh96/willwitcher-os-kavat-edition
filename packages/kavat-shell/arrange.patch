+    std::vector<Arrange::Item> readArrangeItems(const UiTreeNode& node) {
+      std::vector<Arrange::Item> items;
+      const std::vector<std::string>* keys = strArrayProp(node, "itemKeys");
+      if (keys == nullptr || keys->empty()) {
+        return items; // an empty table is read as an empty number array
+      }
+      const std::vector<std::string>* labels = strArrayProp(node, "itemLabels");
+      const std::vector<std::string>* sublabels = strArrayProp(node, "itemSublabels");
+      const std::vector<double>* rects = arrayProp(node, "itemRects");
+      if (rects == nullptr || rects->size() != keys->size() * kArrangeRectFields) {
+        kLog.warn("ui tree: arrange expects {} numbers for each of its items; none shown", kArrangeRectFields);
+        return items;
+      }
+      if (keys->size() > kArrangeMaxItems) {
+        kLog.warn("ui tree: arrange keeps the first {} items", kArrangeMaxItems);
+      }
+      const std::size_t count = std::min(keys->size(), kArrangeMaxItems);
+      items.reserve(count);
+      for (std::size_t i = 0; i < count; ++i) {
+        const double* rect = rects->data() + i * kArrangeRectFields;
+        if (!std::isfinite(rect[0])
