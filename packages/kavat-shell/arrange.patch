+  using SelectHandler = std::function<void(const std::string& key)>;
+  // The position is in layout units, rounded to whole ones.
+  using MoveHandler = std::function<void(const std::string& key, long long x, long long y)>;
+
+  Arrange();
+
+  // Content scale of the surface and the extra multiplier of its text.
+  void setScale(float scale, float fontScale);
+  // The rectangles, in drawing order. Applied only when they differ from the ones given
+  // last, or when `force` is set, so re-applying an unchanged tree never undoes a drop the
+  // caller has not answered yet. A rectangle being dragged keeps the pointer's position.
+  void setItems(std::vector<Item> items, bool force);
+  void setOnSelect(SelectHandler handler) { m_onSelect = std::move(handler); }
+  void setOnMove(MoveHandler handler) { m_onMove = std::move(handler); }
+
+  [[nodiscard]] bool dragging() const noexcept { return m_drag.has_value(); }
+  // Ends a drag in progress, putting the rectangle back where it was. Reports nothing.
+  void cancelDrag();
+
+private:
+  struct Visual {
+    Box* box = nullptr;
+    Label* label = nullptr;
+    Label* sublabel = nullptr;
+  };
+
+  // Layout units to pixels: pixel = origin + (unit - unitOrigin) * factor.
+  struct Transform {
+    double factor = 1.0;
+    double unitX = 0.0;
+    double unitY = 0.0;
+    float originX = 0.0F;
+    float originY = 0.0F;
+  };
+
+  struct Drag {
+    std::size_t index = 0;
+    // Where the rectangle was, to go back to on a cancel.
+    double startX = 0.0;
+    double startY = 0.0;
+    // From the rectangle's corner to the pointer, in layout units.
+    double grabX = 0.0;
+    double grabY = 0.0;
+    float pressX = 0.0F;
+    float pressY = 0.0F;
+    bool moved = false;
+  };
+
+  void onPointerPress(const PointerData& pointer);
+  void onPointerMotion(const PointerData& pointer);
+  void syncVisuals();
+  void applyItemStyle(std::size_t index);
+  void placeItem(std::size_t index);
+  void endDrag();
+  [[nodiscard]] Transform fitTransform() const;
+  [[nodiscard]] std::optional<std::size_t> itemAt(float localX, float localY) const;
+  void snap(std::size_t index, double& x, double& y) const;
+  void doLayout(Renderer& renderer) override;
+
+  Box* m_background = nullptr;
+  std::vector<Item> m_given;
+  std::vector<Item> m_items;
+  std::vector<Visual> m_visuals;
+  // Recomputed by every layout, except during a drag: the plane must not move under the
+  // pointer while a rectangle is carried across it.
+  Transform m_transform;
+  std::optional<Drag> m_drag;
+  SelectHandler m_onSelect;
+  MoveHandler m_onMove;
+  float m_scale = 1.0F;
+  float m_fontScale = 1.0F;
+};
