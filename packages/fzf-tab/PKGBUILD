# fzf-tab is not in Arch's repositories, so the system builds it here: the plugin as its
# author tagged it, with nothing changed.
pkgname=fzf-tab
pkgver=1.3.0
pkgrel=1
pkgdesc="zsh's completions shown in fzf"
arch=('any')
url='https://github.com/Aloxaf/fzf-tab'
license=('MIT')
depends=('zsh' 'fzf')
source=("fzf-tab-$pkgver.tar.gz::https://github.com/Aloxaf/fzf-tab/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('d75ac08c2c8af5a6a0478787b0f11fabbe24951973b7841ae963431e2070ee9a')

package() {
  cd "fzf-tab-$pkgver"
  install -d "$pkgdir/usr/share/zsh/plugins/fzf-tab"
  cp -r fzf-tab.zsh fzf-tab.plugin.zsh lib "$pkgdir/usr/share/zsh/plugins/fzf-tab/"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/fzf-tab/LICENSE"
}
