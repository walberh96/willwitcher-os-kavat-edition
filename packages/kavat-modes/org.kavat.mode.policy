<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- Changing the system's mode stops and starts the units the modes name, and puts up or
     takes down the guard that lets nothing out but through the VPN. The person at the
     machine may do it without a password: it is a switch on the bar. -->
<policyconfig>
  <action id="org.kavat.mode.change">
    <description>Change the system's mode</description>
    <message>Changing the system's mode</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/kavat/mode-root</annotate>
  </action>
</policyconfig>
