#!/bin/bash
# kavat: one command for the whole system. Each word after it is one of the system's own
# programs, which can be called by its own name too.
#
# usage: kavat <what> [...]
#
#   theme       the look: kavat theme set mode light            (kavat-theme)
#   mode        Coder, Gamer, Incognito: kavat mode gamer        (kavat-mode)
#   wallpaper   the background: kavat wallpaper set <file>       (kavat-wallpaper)
#   displays    the displays and their arrangement               (kavat-displays)
#   project     a workspace under a name: kavat project open x   (kavat-project)
#   game        a game's own profile: kavat game new elden       (kavat-game)
#   dns         the names asked for over TLS: kavat dns on       (kavat-dns)
#   sandbox     a program kept to a part of your files           (kavat-sandbox)
#   notes       notes, tasks and reminders                       (kavat-notes)
#   find        the file search                                  (kavat-find)
#   browser     the browser, and its console's commands          (kavat-browser)
#   webapp      a page installed as an app: kavat webapp install (kavat-webapp)
#   remote      reaching this computer from your devices         (kavat-remote)
#   keys        the desktop's shortcuts, and other keys for them (kavat-keys)
#   packages    install, remove, update: kavat packages update   (kav)
#   doctor      the health of the system                         (kav doctor)
#   backup      copies off the computer                          (kavat-backup)
#   history     the changes of your settings, and undoing them   (kavat-history)
#   settings    the settings panel, on a page: kavat settings modes
#   set         a setting an app keeps in its own file           (kavat-conf)
#   fetch       what machine this is                             (kavat-fetch)
#   top         what is running                                  (kavat-top)
declare -A programs=(
  [theme]=kavat-theme [mode]=kavat-mode [wallpaper]=kavat-wallpaper [displays]=kavat-displays [project]=kavat-project
  [notes]=kavat-notes [find]=kavat-find [browser]=kavat-browser [packages]=kav [backup]=kavat-backup
  [history]=kavat-history [set]=kavat-conf [fetch]=kavat-fetch [top]=kavat-top
  [game]=kavat-game [dns]=kavat-dns [sandbox]=kavat-sandbox [webapp]=kavat-webapp [remote]=kavat-remote [keys]=kavat-keys
)
what=${1:-}
case "$what" in
  doctor) exec kav doctor ;;
  settings) exec kavat-shell msg panel-open kavat/settings:panel ${2:+"$2"} ;;
  '' | help | --help | -h) sed -n '2,/^declare/{/^declare/d;s/^# \{0,1\}//;p}' "$0" ;;
  *)
    if [[ -n ${programs[$what]:-} ]]; then
      exec "${programs[$what]}" "${@:2}"
    fi
    echo "kavat: there is no $what; \`kavat help\` lists what there is" >&2
    exit 2
    ;;
esac
