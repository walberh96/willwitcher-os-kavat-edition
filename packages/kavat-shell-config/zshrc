# Part of kavat-shell-config: what every interactive zsh on this system starts with.
# Your own settings go in ~/.zshrc, which is read after this file and has the last word.
#
# Nothing here goes through a framework: each piece is read directly, and what takes time
# to work out is kept from one terminal to the next. Opening a terminal has to stay fast.

# History: kept across terminals, without repeats
HISTFILE="${XDG_STATE_HOME:-$HOME/.local/state}/zsh/history"
[[ -d ${HISTFILE:h} ]] || mkdir -p "${HISTFILE:h}"
HISTSIZE=50000
SAVEHIST=50000
# In a mode that keeps no history, Incognito, nothing typed is written down: kavat-mode
# leaves a file while such a mode is in force, and each prompt looks for it.
_kavat_history() {
  if [[ -e ${XDG_RUNTIME_DIR:-/run/user/$UID}/kavat-no-history ]]; then
    [[ -n $HISTFILE ]] && _kavat_histfile=$HISTFILE && unset HISTFILE
  elif [[ -n $_kavat_histfile ]]; then
    HISTFILE=$_kavat_histfile; unset _kavat_histfile
  fi
}
precmd_functions+=(_kavat_history)
setopt share_history hist_ignore_all_dups hist_ignore_space hist_reduce_blanks
setopt auto_cd interactive_comments

# Keys: the usual ones of a terminal, with Home, End, Delete and Ctrl with the arrows
bindkey -e
bindkey '^[[H' beginning-of-line
bindkey '^[[F' end-of-line
bindkey '^[[3~' delete-char
bindkey '^[[1;5C' forward-word
bindkey '^[[1;5D' backward-word

# Completion. What can be completed is worked out once a day and kept; in between, the
# kept list is used as it is.
autoload -Uz compinit
() {
  local kept="${XDG_CACHE_HOME:-$HOME/.cache}/zsh/zcompdump"
  [[ -d ${kept:h} ]] || mkdir -p "${kept:h}"
  local -a fresh=( ${kept}(N.mh-24) )
  if (( $#fresh )); then
    compinit -C -d "$kept"
  else
    compinit -d "$kept"
  fi
  zstyle ':completion:*' cache-path "${kept:h}/completions"
}
zstyle ':completion:*' use-cache on
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}'

# The picker, fzf: the same one as in the file search, kavat-find, with the theme's colours.
# It lists files with fd, which also shows the hidden ones.
() {
  local look="${XDG_STATE_HOME:-$HOME/.local/state}/kavat/theme/current/fzf/options"
  [[ -e $look ]] && export FZF_DEFAULT_OPTS_FILE="$look"
}
export BAT_THEME=ansi
export FZF_DEFAULT_COMMAND='fd --type file --type symlink --hidden --exclude .git --exclude .cache'
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
export FZF_CTRL_T_OPTS="--preview 'bat --color always --style numbers --line-range :200 {}'"
export FZF_ALT_C_COMMAND='fd --type directory --hidden --exclude .git --exclude .cache'
export FZF_ALT_C_OPTS="--preview 'lsd -la --color always {}'"

# Ctrl+R looks through the history, Ctrl+T puts a file's path in the command and Alt+C
# goes to a folder
source /usr/share/fzf/key-bindings.zsh
source /usr/share/fzf/completion.zsh

# Tab shows what can be completed in the picker, with a look at each file or folder; / goes
# into the folder under the cursor. It has to be read after compinit and fzf's own keys, which
# take Tab too, and before the two plugins further down.
source /usr/share/zsh/plugins/fzf-tab/fzf-tab.plugin.zsh
zstyle ':completion:*' menu no
zstyle ':completion:*:descriptions' format '[%d]'
zstyle ':fzf-tab:*' use-fzf-default-opts yes
zstyle ':fzf-tab:complete:*:*' fzf-preview \
  'if [[ -d $realpath ]]; then lsd -la --color always $realpath; elif [[ -f $realpath ]]; then bat --color always --style numbers --line-range :200 $realpath; fi'
zstyle ':fzf-tab:complete:(kill|ps):argument-rest' fzf-preview 'ps -p $word -o cmd --no-headers -w -w'
zstyle ':fzf-tab:complete:(kill|ps):argument-rest' fzf-flags --preview-window=down:3:wrap

# Suggestions from the history as you type; the right arrow takes one
source /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh

# Ctrl+G looks for text inside the files of this folder
kavat-find-text() {
  kavat-find text < /dev/tty
  zle reset-prompt
}
zle -N kavat-find-text
bindkey '^G' kavat-find-text

# zoxide: z and part of a folder's name goes there
eval "$(zoxide init zsh)"

# The editor programs open when they need one
export EDITOR=nvim VISUAL=nvim

# lsd in the place of ls
alias ls='lsd'
alias ll='lsd -l'
alias la='lsd -la'

# The prompt: the system's, until you have your own in ~/.config/starship.toml
[[ -e ${XDG_CONFIG_HOME:-$HOME/.config}/starship.toml ]] || export STARSHIP_CONFIG=/usr/share/kavat/starship.toml
eval "$(starship init zsh)"

# Colours for what you type, as you type it. It has to be the last thing read.
source /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
