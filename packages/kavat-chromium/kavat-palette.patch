@@ -0,0 +1,22 @@
+// Willwitcher-OS Kavat Edition: the system's palette in the browser's own colours.
+
+#ifndef CHROME_BROWSER_UI_COLOR_LINUX_KAVAT_PALETTE_COLOR_MIXER_H_
+#define CHROME_BROWSER_UI_COLOR_LINUX_KAVAT_PALETTE_COLOR_MIXER_H_
+
+#include "ui/color/color_provider_key.h"
+
+namespace ui {
+class ColorProvider;
+}
+
+// Adds a mixer that gives the Material "sys" colours, which the browser's own
+// pages, the side panel, menus and bubbles are drawn with, the colours of the
+// system's theme, as kavat-theme writes them in
+// $XDG_STATE_HOME/kavat/theme/current/browser/palette. It does nothing when
+// the browser does not take its look from the system (GTK or Qt), when that
+// file is not there, or when its mode is not the one asked for, as in a dark
+// Incognito window over a light system. It must be the last mixer added.
+void AddKavatPaletteColorMixer(ui::ColorProvider* provider,
+                               const ui::ColorProviderKey& key);
+
+#endif  // CHROME_BROWSER_UI_COLOR_LINUX_KAVAT_PALETTE_COLOR_MIXER_H_
