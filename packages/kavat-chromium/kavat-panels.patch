+// Kavat: the system hides the parts of a browser window around the page, while the window
+// is open. It writes their names in a file, $XDG_RUNTIME_DIR/kavat-browser/parts: "tabs",
+// "toolbar", "bookmarks" and "sidepanel", any of them, or "zen" for the four; a file that
+// is empty or missing hides nothing. The file is watched and read away from the UI thread,
+// and what it says goes to every normal window; app windows, popups and picture-in-picture
+// keep their own parts. Hidden, a part goes the way fullscreen takes it, and the window
+// stays the size the window manager gives it.
+enum KavatPart {
+  kKavatTabs = 1 << 0,
+  kKavatToolbar = 1 << 1,
+  kKavatBookmarks = 1 << 2,
+  kKavatSidePanel = 1 << 3,
+};
+
+// the parts hidden now; used on the UI thread only
+int g_kavat_hidden = 0;
+
+// Runs on the watcher's sequence, which may block.
+int ReadKavatParts(const base::FilePath& file) {
+  std::string text;
+  // a file this large is not one the system wrote
+  if (!base::ReadFileToStringWithMaxSize(file, &text, 4096)) {
+    return 0;
+  }
+  int parts = 0;
+  for (std::string_view word :
+       base::SplitStringPiece(text, base::kWhitespaceASCII,
+                              base::TRIM_WHITESPACE,
+                              base::SPLIT_WANT_NONEMPTY)) {
+    if (word == "tabs") {
+      parts |= kKavatTabs;
+    } else if (word == "toolbar") {
+      parts |= kKavatToolbar;
+    } else if (word == "bookmarks") {
+      parts |= kKavatBookmarks;
+    } else if (word == "sidepanel") {
+      parts |= kKavatSidePanel;
+    } else if (word == "zen") {
+      parts |= kKavatTabs | kKavatToolbar | kKavatBookmarks | kKavatSidePanel;
+    }
+  }
+  return parts;
+}
+
+// Runs on the UI thread: every normal window lays itself out again, as it does when it
+// leaves fullscreen. The side panel is closed when it becomes hidden; opened again by a
+// press of yours, it shows.
+void ApplyKavatParts(int hidden) {
+  const int was = g_kavat_hidden;
+  if (hidden == was) {
+    return;
+  }
+  g_kavat_hidden = hidden;
+  GlobalBrowserCollection::GetInstance()->ForEach(
+      [was, hidden](BrowserWindowInterface* browser) {
+        if (browser->GetType() != BrowserWindowInterface::Type::TYPE_NORMAL ||
+            browser->IsDeleteScheduled()) {
+          return true;
+        }
+        BrowserView* const view = BrowserView::GetBrowserViewForBrowser(browser);
+        if (!view || !view->GetWidget() || !view->browser_widget()) {
+          return true;
+        }
+        if ((hidden & kKavatSidePanel) && !(was & kKavatSidePanel)) {
+          if (SidePanelUI* const side_panel = SidePanelUI::From(browser)) {
+            side_panel->Close();
+          }
+        }
+        if (BrowserFrameView* const frame =
+                view->browser_widget()->GetFrameView()) {
+          frame->OnTabStripStateChanged();
+        }
+        view->ToolbarSizeChanged(/*is_animating=*/false);
+        view->InvalidateLayout();
+        return true;
+      });
+}
+
+// Runs on the watcher's sequence: the file is read now and at every change of it. The
+// watcher lives as long as the browser does.
+void WatchKavatParts(const base::FilePath& file,
+                     scoped_refptr<base::SequencedTaskRunner> ui) {
+  static base::NoDestructor<base::FilePathWatcher> watcher;
+  const base::FilePathWatcher::Callback read = base::BindRepeating(
+      [](const base::FilePath& watched,
+         scoped_refptr<base::SequencedTaskRunner> reply,
+         const base::FilePath&, bool) {
+        reply->PostTask(FROM_HERE, base::BindOnce(&ApplyKavatParts,
+                                                  ReadKavatParts(watched)));
+      },
+      file, ui);
+  // a file that does not exist yet is waited for in its folder
+  watcher->Watch(file, base::FilePathWatcher::Type::kNonRecursive, read);
+  read.Run(file, false);
+}
+
+// The parts hidden now. The first window to ask starts the watch.
+int KavatHiddenParts() {
+  static bool started = false;
+  if (!started) {
+    started = true;
+    const std::optional<std::string> runtime =
+        base::Environment::Create()->GetVar("XDG_RUNTIME_DIR");
+    if (runtime && !runtime->empty()) {
+      base::ThreadPool::CreateSequencedTaskRunner(
+          {base::MayBlock(), base::TaskPriority::USER_VISIBLE,
+           base::TaskShutdownBehavior::CONTINUE_ON_SHUTDOWN})
+          ->PostTask(FROM_HERE,
+                     base::BindOnce(
+                         &WatchKavatParts,
+                         base::FilePath(*runtime)
+                             .Append(FILE_PATH_LITERAL("kavat-browser"))
+                             .Append(FILE_PATH_LITERAL("parts")),
+                         base::SequencedTaskRunner::GetCurrentDefault()));
+    }
+  }
+  return g_kavat_hidden;
+}
