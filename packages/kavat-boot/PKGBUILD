pkgname=kavat-boot
pkgver=0.1.0
pkgrel=6
pkgdesc="Willwitcher-OS Kavat Edition: the boot menu's entries, safe mode, the recovery console, the boot that remembers whether the last one failed, and GRUB opening an encrypted disk"
arch=('any')
url='https://github.com/walberh96/willwitcher-os-kavat-edition'
license=('LicenseRef-AllRightsReserved')
depends=('grub' 'hyprland' 'systemd')
install=kavat-boot.install
source=('00_kavat-unlock' '02_kavat-boot-check' '10_kavat' '11_kavat-safe-mode' '42_kavat-recovery'
        '43_kavat-firmware' '44_kavat-other-systems' 'grub-defaults.cfg' 'kavat-boot.hook'
        'boot-state' 'kavat-session' 'kavat.desktop' 'kavat-boot-state@.service'
        'kavat-boot-greeter.service' 'kavat-boot-session.path' 'kavat-boot-desktop.path'
        'kavat-rescue' 'kavat-rescue.service' 'kavat-rescue.target' 'tmpfiles.conf')
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP'
            'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP')

package() {
  install -Dm755 -t "$pkgdir/etc/grub.d" 00_kavat-unlock 02_kavat-boot-check 10_kavat 11_kavat-safe-mode \
    42_kavat-recovery 43_kavat-firmware 44_kavat-other-systems
  install -Dm644 grub-defaults.cfg "$pkgdir/etc/default/grub.d/kavat.cfg"
  install -Dm644 kavat-boot.hook "$pkgdir/usr/share/libalpm/hooks/kavat-boot.hook"
  install -Dm755 kavat-rescue "$pkgdir/usr/bin/kavat-rescue"
  install -Dm755 boot-state "$pkgdir/usr/lib/kavat/boot-state"
  install -Dm755 kavat-session "$pkgdir/usr/bin/kavat-session"
  install -Dm644 kavat.desktop "$pkgdir/usr/share/wayland-sessions/kavat.desktop"
  install -Dm644 -t "$pkgdir/usr/lib/systemd/system" kavat-boot-state@.service \
    kavat-boot-greeter.service kavat-boot-session.path kavat-boot-desktop.path \
    kavat-rescue.service kavat-rescue.target
  install -Dm644 tmpfiles.conf "$pkgdir/usr/lib/tmpfiles.d/kavat-boot.conf"
}
