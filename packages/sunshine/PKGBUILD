# Sunshine is not in Arch's repositories, so the system builds it here: the program as its
# project tagged it, with its own build file for Arch as the start,
# packaging/linux/Arch/PKGBUILD, which is also the AUR's. Left out of that file: CUDA, the
# unit tests and the checks of the files for app stores. Kept from it: two fixes that are
# already in the project, for the OpenSSL and the CMake that Arch has. It shows the desktop
# to Moonlight; kavat-remote starts it, and nothing here does.
pkgname=sunshine
pkgver=2026.914.233613
pkgrel=1
pkgdesc="Self-hosted game stream host for Moonlight"
arch=('x86_64')
url='https://app.lizardbyte.dev/Sunshine'
license=('GPL-3.0-only')
install=sunshine.install
depends=('avahi' 'curl' 'gcc-libs' 'gtk3' 'hicolor-icon-theme' 'libayatana-appindicator' 'libcap' 'libdrm'
         'libevdev' 'libmfx' 'libpipewire' 'libpulse' 'libva' 'libx11' 'libxcb' 'libxfixes' 'libxrandr'
         'libxtst' 'miniupnpc' 'numactl' 'openssl' 'opus' 'qt6-base' 'qt6-svg' 'systemd-libs'
         'vulkan-icd-loader' 'which')
# systemd: its build asks it where the session's units, the udev rules and the modules to load go
makedepends=('cmake' 'make' 'nodejs' 'npm' 'python-jinja' 'shaderc' 'systemd')
# the commit of the tag v$pkgver. Sunshine keeps eighteen other projects inside it, some with
