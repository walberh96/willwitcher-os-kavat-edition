prepare() {
  mv "Sunshine-$_commit" sunshine
  cd sunshine
  # each part into its place, the ones outside before the ones inside them
  local part where repo commit
  for part in "${_parts[@]}"; do
    read -r where repo commit <<< "$part"
    rmdir "$where" 2> /dev/null || rm -rf "$where"
    mkdir -p "$(dirname "$where")"
    cp -a "$srcdir/${repo#*/}-$commit" "$where"
  done
  # Sunshine's own commit dac66dfd: the length of a certificate's signature, with OpenSSL 4.1
  patch -Np1 -i "$srcdir/openssl-4.1-signature-length.patch"
  # Boost.Locale's own commits 1d070743 and f51b58cd: its list of sources, with a newer CMake
  patch -Np1 -d "$srcdir/boost-$_boost" -i "$srcdir/boost-1.89.0-locale-cmake-4.5.patch"
}

build() {
  # what the program says its version is
  export BRANCH=master BUILD_VERSION="$pkgver" COMMIT="$_commit"
  export CFLAGS="${CFLAGS/-Werror=format-security/}"
  export CXXFLAGS="${CXXFLAGS/-Werror=format-security/}"
  # Boost is the copy patched above, not one more download; a warning of a newer compiler
  # does not stop the build
  cmake -S sunshine -B build -Wno-dev \
    -D BUILD_DOCS=OFF \
    -D BUILD_TESTS=OFF \
    -D BUILD_WERROR=OFF \
    -D CMAKE_INSTALL_PREFIX=/usr \
    -D FETCHCONTENT_SOURCE_DIR_BOOST="$srcdir/boost-$_boost" \
    -D FFMPEG_PREPARED_BINARIES="$srcdir/ffmpeg" \
    -D SUNSHINE_EXECUTABLE_PATH=/usr/bin/sunshine \
    -D SUNSHINE_ASSETS_DIR=share/sunshine \
    -D SUNSHINE_PUBLISHER_NAME=LizardByte \
    -D SUNSHINE_PUBLISHER_WEBSITE=https://app.lizardbyte.dev \
    -D SUNSHINE_PUBLISHER_ISSUE_URL=https://app.lizardbyte.dev/support \
    -D SUNSHINE_ENABLE_CUDA=OFF \
    -D CUDA_FAIL_ON_MISSING=OFF
  cmake --build build
}

check() {
  cd build
  ./sunshine --version
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
