#!/usr/bin/env python3
"""Fill the installer in from the answers of an earlier installation.

usage: answers [file]

An installed system keeps the answers of its installation in /etc/kavat/kavat-install.toml.
`kavat-installer` runs this, as root, before it opens Calamares: with that file, or with
one of that name found at the top of a USB stick, the installer's settings in the live
session are changed so that each page comes up already answered. With no file, they are
put back as the package brought them.

What is filled in: the language, the time zone, the keyboard, the names of the user and of
the machine, how the disk is used and whether it is encrypted, the look, and the programs.
What is not: the passwords, which no file holds, and which disk it is. An answer that is
not what its page could have given is left out, and its page comes up as it always does.

It prints the locale the installer is to be opened in, when the file names one.
"""
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import tomllib

NAME = 'kavat-install.toml'
CONFIG = '/etc/calamares'
STOCK = '/usr/share/calamares/modules'  # the settings Calamares itself brings
ORIGINAL = '/run/kavat-installer/original'  # the installer's settings as the package brought them
ZONES = '/usr/share/zoneinfo'
# the settings that are changed; the keyboard's are Calamares' own until they are
CHANGED = ('modules/locale.conf', 'modules/keyboard.conf', 'modules/partition.conf', 'modules/users.conf',
           'branding/kavat/answers.js')
PACKAGE = r'[a-z0-9][a-z0-9@._+-]*'
# what each answer may be: (section, name) and what it has to match in full
ALLOWED = {
    ('system', 'locale'): r'[a-z]{2,3}_[A-Z]{2}\.UTF-8',
    ('system', 'timezone'): r'[A-Za-z_]+(/[A-Za-z0-9_+-]+){1,2}',
    ('system', 'keyboard'): r'[a-z]{2,10}',
    ('system', 'keyboard_variant'): r'[a-z0-9_-]+',
    ('system', 'hostname'): r'[a-zA-Z0-9][-a-zA-Z0-9_.]{1,62}',
    ('user', 'name'): r'[^\x00-\x1f\x7f:]{1,100}',
    ('user', 'login'): r'[a-z_][a-z0-9_-]{0,30}',
    ('disk', 'method'): r'erase|replace|alongside|manual',
    ('appearance', 'palette'): r'[a-z][a-z0-9-]*',
    ('appearance', 'mode'): r'dark|light|auto',
    ('appearance', 'accent'): r'[a-z][a-z0-9-]*',
}


def say(message):
    print(f'kavat-installer: {message}', file=sys.stderr)


def put_back():
    """Leave the installer's settings as the package brought them, keeping them the first time."""
    first = not os.path.isdir(ORIGINAL)
    for name in CHANGED:
        ours, kept = os.path.join(CONFIG, name), os.path.join(ORIGINAL, name)
        if first:
            os.makedirs(os.path.dirname(kept), exist_ok=True)
            if os.path.exists(ours):
                shutil.copy2(ours, kept)
        elif os.path.exists(kept):
            shutil.copy2(kept, ours)
        elif os.path.exists(ours):
            os.remove(ours)


def on_a_stick():
    """The answers file at the top of a disk that is plugged in: (its text, where it was).

    The session mounts a stick when it is plugged in. One that is not mounted, on a USB
    disk, is mounted here to look, without writing to it, and taken out again.
    """
    mounted = set()
    with open('/proc/self/mounts', encoding='utf-8') as mounts:
        for line in mounts:
            device, where = line.split()[:2]
            if device.startswith('/dev/'):
                mounted.add(os.path.realpath(device))
                # a space in a folder's name is written \040 there
                path = os.path.join(re.sub(r'\\([0-7]{3})', lambda code: chr(int(code.group(1), 8)), where), NAME)
                if os.path.isfile(path):
                    with open(path, encoding='utf-8', errors='replace') as file:
                        return file.read(), path
    try:
        listed = subprocess.run(['lsblk', '--json', '--tree', '-o', 'PATH,FSTYPE,RM,TRAN'], capture_output=True,
                                text=True, check=True, timeout=30)
        disks = json.loads(listed.stdout)['blockdevices']
    except (OSError, ValueError, KeyError, subprocess.SubprocessError):
        return None, None
    for disk in disks:
        if disk.get('tran') != 'usb' and disk.get('rm') not in (True, '1'):
            continue
        for part in disk.get('children', []):
            if part.get('fstype') not in ('vfat', 'exfat') or os.path.realpath(part['path']) in mounted:
                continue
            with tempfile.TemporaryDirectory(prefix='kavat-installer-') as folder:
                if subprocess.run(['mount', '-o', 'ro', part['path'], folder], capture_output=True, check=False).returncode:
                    continue
                try:
                    path = os.path.join(folder, NAME)
                    if os.path.isfile(path):
                        with open(path, encoding='utf-8', errors='replace') as file:
                            return file.read(), f'{part["path"]}:/{NAME}'
                finally:
                    subprocess.run(['umount', folder], capture_output=True, check=False)
    return None, None


def read(text):
    """The answers of the file that are what a page could have given: {(section, name): value}."""
    try:
        file = tomllib.loads(text)
    except tomllib.TOMLDecodeError as error:
        say(f'the answers file cannot be read: {error}')
        return {}
    answers = {}
    for (section, name), pattern in ALLOWED.items():
        value = file.get(section, {}).get(name) if isinstance(file.get(section), dict) else None
        if value is None:
            continue
        if isinstance(value, str) and re.fullmatch(pattern, value):
            answers[section, name] = value
        else:
            say(f'{name} in [{section}] is left out: it is not an answer the installer gives')
    if ('system', 'timezone') in answers and not os.path.isfile(os.path.join(ZONES, answers['system', 'timezone'])):
        say('timezone in [system] is left out: there is no such time zone')
        del answers['system', 'timezone']
    disk, software = file.get('disk'), file.get('software')
    if isinstance(disk, dict) and isinstance(disk.get('encrypt'), bool):
        answers['disk', 'encrypt'] = disk['encrypt']
    user = file.get('user')
    if isinstance(user, dict) and isinstance(user.get('autologin'), bool):
        answers['user', 'autologin'] = user['autologin']
    if isinstance(software, dict) and isinstance(software.get('asked'), list):
        answers['software', 'asked'] = [name for name in software['asked']
                                        if isinstance(name, str) and re.fullmatch(PACKAGE, name)]
    return answers


def change(name, settings):
    """Give settings of one of the installer's files other values: {key: the value, as YAML}."""
    path = os.path.join(CONFIG, name)
    with open(path, encoding='utf-8') as file:
        text = file.read()
    for key, value in settings.items():
        text, found = re.subn(rf'^([ \t]*{key}:).*$', lambda line: f'{line.group(1)} {value}', text, count=1, flags=re.MULTILINE)
        if not found:
            say(f'{name} has no {key}: that answer is not filled in')
    with open(path, 'w', encoding='utf-8') as file:
        file.write(text)


def fill_in(answers, where):
    """Change the installer's settings so that its pages come up with these answers."""
    # a string of JSON is a string of YAML too
    quoted = json.dumps
    zone = answers.get(('system', 'timezone'))
    if zone:
        region, zone = zone.split('/', 1)
        change('modules/locale.conf', {'region': quoted(region), 'zone': quoted(zone)})

    # The keyboard page starts from the keyboard of the live session, unless it guesses one
    # from the language: the session is given the layout, and the guess is turned off.
    layout = answers.get(('system', 'keyboard'))
    stock = os.path.join(STOCK, 'keyboard.conf')
    if layout and os.path.isfile(stock):
        set_layout = ['localectl', '--no-convert', 'set-x11-keymap', layout, '', answers.get(('system', 'keyboard_variant'), '')]
        if subprocess.run(set_layout, capture_output=True, check=False).returncode == 0:
            with open(stock, encoding='utf-8') as file:
                settings = file.read()
            with open(os.path.join(CONFIG, 'modules/keyboard.conf'), 'w', encoding='utf-8') as file:
                file.write(settings.rstrip('\n') + '\n\n# from the answers file: the page starts from the layout the session was given\n'
                           'guessLayout: false\n')
        else:
            say('the keyboard is not filled in: the session did not take the layout')

    disk = {}
    if ('disk', 'method') in answers:
        disk['initialPartitioningChoice'] = answers['disk', 'method']
    if ('disk', 'encrypt') in answers:
        # the box comes checked; its password is typed again
        disk['preCheckEncryption'] = 'true' if answers['disk', 'encrypt'] else 'false'
    if disk:
        change('modules/partition.conf', disk)

    # the name of the machine is made from a template when the user's name is filled in
    if ('system', 'hostname') in answers:
        change('modules/users.conf', {'template': quoted(answers['system', 'hostname'])})
    if answers.get(('user', 'autologin')) is True:
        change('modules/users.conf', {'doAutologin': 'true'})
    names = [(field, answers[key]) for field, key in (('fullName', ('user', 'name')), ('loginName', ('user', 'login')))
             if key in answers]
    if names:
        with open(os.path.join(CONFIG, 'modules/users.conf'), 'a', encoding='utf-8') as file:
            file.write('# from the answers file; they can still be changed on the page\npresets:\n')
            for field, value in names:
                file.write(f'    {field}:\n        value: {quoted(value)}\n        editable: true\n')

    # what the installer's own pages start from, and what the side bar says
    pages = {'from': os.path.basename(where)}
    for name in ('palette', 'mode', 'accent'):
        if ('appearance', name) in answers:
            pages[name] = answers['appearance', name]
    if ('software', 'asked') in answers:
        pages['software'] = answers['software', 'asked']
    with open(os.path.join(CONFIG, 'branding/kavat/answers.js'), 'w', encoding='utf-8') as file:
        file.write('// Made by /usr/lib/kavat-installer/answers, from the answers file the installer was started with.\n'
                   '.pragma library\nvar answers = ' + json.dumps(pages, indent=1) + '\n')


def main():
    if len(sys.argv) > 2 or (len(sys.argv) == 2 and sys.argv[1].startswith('-')):
        sys.exit(__doc__)
    put_back()
    if len(sys.argv) == 2 and sys.argv[1]:
        where = sys.argv[1]
        try:
            with open(where, encoding='utf-8', errors='replace') as file:
                text = file.read()
        except OSError as error:
            sys.exit(f'kavat-installer: {where} cannot be read: {error.strerror}')
    else:
        text, where = on_a_stick()
        if text is None:
            return
    answers = read(text)
    if not answers:
        say(f'{where} has no answers: the installer opens as it always does')
        return
    fill_in(answers, where)
    say(f'filled in from {where}')
    if ('system', 'locale') in answers:
        print(answers['system', 'locale'])


if __name__ == '__main__':
    main()
