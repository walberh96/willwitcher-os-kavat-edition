#!/bin/bash
# Runs inside the new system: puts GRUB on the EFI partition.
#
# GRUB's own files, its settings and its environment block go on the EFI partition, where
# GRUB can write: on Btrfs it cannot, and "boot this once" and the safe mode after a failed
# boot both need it to. The kernels stay in /boot, inside the system, so that each snapshot
# keeps its own. /boot/grub points to the EFI partition, where every tool expects it.
#
# There is no Secure Boot: GRUB without shim boots no kernel under it, and the system does
# not take shim. It has to be off in the firmware.
set -euo pipefail

grub-install --target=x86_64-efi --efi-directory=/efi --boot-directory=/efi --bootloader-id=Kavat
# The same loader where firmware looks when it has lost its boot entries, unless another
# system on a shared EFI partition already put its own there.
if [[ ! -e /efi/EFI/BOOT/BOOTX64.EFI ]]; then
  install -Dm644 /efi/EFI/Kavat/grubx64.efi /efi/EFI/BOOT/BOOTX64.EFI
fi

rm -rf /boot/grub
ln -s /efi/grub /boot/grub

# The boot menu, the loading screen and the login screen get the look of the system's
# theme. The loading screen travels inside the boot image, which the installer builds right
# after this, so it is not built here. A look that cannot be made is no reason to stop:
# the three screens work without one.
KAVAT_THEME_BOOT_IMAGE=later kavat-theme boot || echo 'kavat-theme: the boot keeps its plain look' >&2

grub-mkconfig -o /boot/grub/grub.cfg
