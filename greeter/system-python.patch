 from dataclasses import dataclass, fields, field
 
 from logger import logger
-from dataclass_binder import Binder
+
+
+def bind(kind, values):
+    """Fills in a dataclass with what a TOML table holds. A key may use - or _."""
+    known = {item.name: item for item in fields(kind)}
+    filled = {}
+    for key, value in values.items():
+        name = key.replace("-", "_")
+        if name not in known:
+            raise ValueError(f'"{key}" is not a setting')
+        made = known[name].default_factory
+        if made is not dataclasses.MISSING and dataclasses.is_dataclass(made):
+            value = bind(made, value)
+        filled[name] = value
+    return kind(**filled)
 
 
