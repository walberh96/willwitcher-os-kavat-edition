<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
  "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- Part of kavat-theme. What the password dialog says when kavat-theme boot asks to change
     the boot menu, the loading screen and the login screen, and who may say yes: an
     administrator, each time. -->
<policyconfig>
  <vendor>Willwitcher-OS Kavat Edition</vendor>
  <vendor_url>https://github.com/walberh96/willwitcher-os-kavat-edition</vendor_url>
  <action id="org.kavat.theme.boot">
    <description>Give the boot menu, the loading screen and the login screen the look of the desktop</description>
    <message>The boot menu, the loading screen and the login screen are files of the system. Your password lets them take the look of your desktop.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/kavat-theme</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">boot</annotate>
  </action>
</policyconfig>
