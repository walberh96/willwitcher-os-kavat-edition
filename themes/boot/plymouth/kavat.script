# The loading screen of Willwitcher-OS Kavat Edition. Made by kavat-theme: a change here is
# lost the next time the theme is applied.
#
# The logo with a ring that grows and fades around it, over the same picture as the boot
# menu. Everything is drawn for a screen 1080 pixels tall and scaled to the one there is.

Window.SetBackgroundTopColor({{ bg | parts }});
Window.SetBackgroundBottomColor({{ bg | parts }});

back = Sprite();
logo_sprite = Sprite();
name_sprite = Sprite();
hint_sprite = Sprite();
ring_sprite = Sprite();
steps = 44;
width = 0;
height = 0;
ticks = 0;

fun Place(sprite, image, y, z) {
    sprite.SetImage(image);
    sprite.SetPosition((global.width - image.GetWidth()) / 2, y - image.GetHeight() / 2, z);
}

fun Sized(file) {
    image = Image(file);
    return image.Scale(image.GetWidth() * global.unit, image.GetHeight() * global.unit);
}

# Everything is sized and put in its place for the screen there is. The screen can change
# while this runs: the loading screen starts on the one the firmware left, and moves to the
# graphics driver's when that is ready, which may have another size.
fun Layout() {
    global.width = Window.GetWidth();
    global.height = Window.GetHeight();
    global.unit = global.height / 1080;
    global.middle = global.height * 0.46;

    # the picture fills the screen; what does not fit is cut, as the boot menu does
    picture = Image("background.png");
    fill = Math.Max(global.width / picture.GetWidth(), global.height / picture.GetHeight());
    Place(back, picture.Scale(picture.GetWidth() * fill, picture.GetHeight() * fill), global.height / 2, -100);

    Place(logo_sprite, Image("logo.png").Scale(120 * global.unit, 120 * global.unit), global.middle, 10);
    Place(name_sprite, Sized("name.png"), global.middle + 152 * global.unit, 10);
    Place(hint_sprite, Sized("hint.png"), global.height - 56 * global.unit, 10);

    # the ring, one picture for each step of its 2.2 seconds
    ring = Image("ring.png");
    for (step = 0; step < steps; step++) {
        part = step / steps;
        eased = 1 - (1 - part) * (1 - part);
        size = 190 * global.unit * (0.75 + 0.55 * eased);
        global.rings[step] = ring.Scale(size, size);
    }
}
Layout();

# Plymouth calls this 50 times a second.
fun Refresh() {
    if (Window.GetWidth() != width || Window.GetHeight() != height) Layout();
    step = Math.Int(ticks * 20 / 50) % steps;
    global.ticks = ticks + 1;
    Place(ring_sprite, rings[step], middle, 5);
    ring_sprite.SetOpacity(0.7 * (1 - step / steps));
}
Plymouth.SetRefreshFunction(Refresh);

# The disk is open by the time this screen shows, so nothing here asks for a password. If
# something else does, the question goes under the name, with a dot for each character.
ask_sprite = Sprite();
dots_sprite = Sprite();

fun Ask(question, typed) {
    ask = Image.Text(question, {{ text | parts }});
    dots = "";
    for (count = 0; count < typed; count++) dots += "•";
    marks = Image.Text(dots + " ", {{ accent | parts }});
    ask_sprite.SetImage(ask);
    ask_sprite.SetPosition((width - ask.GetWidth()) / 2, middle + 200 * unit, 10);
    dots_sprite.SetImage(marks);
    dots_sprite.SetPosition((width - marks.GetWidth()) / 2, middle + 200 * unit + ask.GetHeight() * 1.5, 10);
    ask_sprite.SetOpacity(1);
    dots_sprite.SetOpacity(1);
}
Plymouth.SetDisplayPasswordFunction(Ask);

fun Normal() {
    ask_sprite.SetOpacity(0);
    dots_sprite.SetOpacity(0);
}
Plymouth.SetDisplayNormalFunction(Normal);
