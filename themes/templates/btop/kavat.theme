# Made by kavat-theme from the theme's settings; what is changed here is lost.
# The settings are in ~/.config/kavat/theme.toml.

theme[main_bg]="{{ term_bg }}"
theme[main_fg]="{{ text }}"
theme[title]="{{ text }}"
theme[hi_fg]="{{ accent_text }}"
theme[selected_bg]="{{ selection }}"
theme[selected_fg]="{{ text }}"
theme[inactive_fg]="{{ term8 }}"
theme[graph_text]="{{ muted }}"
theme[meter_bg]="{{ surface2 }}"
theme[proc_misc]="{{ cyan }}"
theme[cpu_box]="{{ border }}"
theme[mem_box]="{{ border }}"
theme[net_box]="{{ border }}"
theme[proc_box]="{{ border }}"
theme[div_line]="{{ border }}"
theme[temp_start]="{{ green }}"
theme[temp_mid]="{{ yellow }}"
theme[temp_end]="{{ red }}"
theme[cpu_start]="{{ accent_text }}"
theme[cpu_mid]="{{ yellow }}"
theme[cpu_end]="{{ red }}"
theme[free_start]="{{ green }}"
theme[free_mid]="{{ green }}"
theme[free_end]="{{ green_light }}"
theme[cached_start]="{{ blue }}"
theme[cached_mid]="{{ blue }}"
theme[cached_end]="{{ blue_light }}"
theme[available_start]="{{ cyan }}"
theme[available_mid]="{{ cyan }}"
theme[available_end]="{{ cyan_light }}"
theme[used_start]="{{ accent_text }}"
theme[used_mid]="{{ yellow }}"
theme[used_end]="{{ red }}"
theme[download_start]="{{ blue }}"
theme[download_mid]="{{ blue }}"
theme[download_end]="{{ blue_light }}"
theme[upload_start]="{{ magenta }}"
theme[upload_mid]="{{ magenta }}"
theme[upload_end]="{{ magenta_light }}"
theme[process_start]="{{ accent_text }}"
theme[process_mid]="{{ yellow }}"
theme[process_end]="{{ red }}"
