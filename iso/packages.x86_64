# Packages of the live system, one per line.

# Base and boot
base
kavat-base
kavat-boot
kavat-snapshots
linux-zen
linux-lts
linux-firmware
amd-ucode
intel-ucode
mkinitcpio
mkinitcpio-archiso
sudo
# the installer looks for systemd with which; without it, the boot image is not systemd's
which

# What the installed system boots and lives on
grub
efibootmgr
os-prober
btrfs-progs
dosfstools

# Network
networkmanager
iwd
wireless-regdb

# Loading screen of the installed system, with Plymouth's own theme until the system's
# theme exists
plymouth

# Sound
pipewire
pipewire-pulse
wireplumber
rtkit

# Graphics: Mesa comes with Hyprland; this is the Vulkan driver of the target machine
vulkan-radeon

# Desktop: Hyprland and Noctalia as Arch ships them, with the configuration from [kavat].
# kavat-hyprland brings what its shortcuts open: Kitty, Yazi, hyprlock and the capture tools,
# and the theme system, kavat-theme, that gives all of them their look.
hyprland
noctalia
kavat-hyprland

# Login screen of the installed system. The live session does not use it.
# lightdm-gtk-greeter stands in until the system's own greeter exists.
lightdm
lightdm-gtk-greeter
xorg-server

# The installer. It takes itself out of the system it installs.
kavat-installer

# Fonts
inter-font
ttf-jetbrains-mono-nerd
noto-fonts
noto-fonts-emoji

# Virtual machines: tests/boot.py checks the running system through this agent
qemu-guest-agent
