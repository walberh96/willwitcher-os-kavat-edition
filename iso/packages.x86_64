# Packages of the live system, one per line.

# Base and boot
base
kavat-base
kavat-boot
kavat-snapshots
# kav: the one command over pacman. The AUR is reached only through its reviewed list.
kav
linux-zen
linux-lts
linux-firmware
amd-ucode
intel-ucode
mkinitcpio
mkinitcpio-archiso
sudo
# the installer looks for systemd with which; without it, the boot image is not systemd's
which

# What the installed system boots and lives on
grub
efibootmgr
os-prober
btrfs-progs
dosfstools

# Network
networkmanager
iwd
wireless-regdb
# a VPN from a provider's OpenVPN file; WireGuard needs nothing more
networkmanager-openvpn

# Bluetooth: its service is on, and the Network page of the settings pairs the devices
bluez
bluez-utils

# Loading screen of the installed system. Its look comes from kavat-theme.
plymouth

# Sound
pipewire
pipewire-pulse
wireplumber
rtkit

# Graphics: Mesa comes with Hyprland; this is the Vulkan driver of the target machine
vulkan-radeon

# Desktop: Hyprland as Arch ships it, and Kavat Shell, the system's shell, with
# the configuration from [kavat].
# kavat-hyprland brings what its shortcuts open: Kitty, Yazi, hyprlock and the capture tools,
# and the theme system, kavat-theme, that gives all of them their look.
hyprland
kavat-shell
kavat-hyprland

# Login screen of the installed system: greetd, with the system's own greeter, which draws
# its page on Wayland. The live session does not use it.
kavat-greeter

# The terminal's shell: zsh with the system's prompt, and the everyday tools that come
# with it. The live session keeps bash.
kavat-shell-config

# The file search: kavat-find, over fd, plocate and ripgrep, with fzf as its picker. It
# comes with the two packages above; it is named here because it is a piece of its own.
kavat-find

# The file manager: Yazi, set up, and the window every app picks its files with
kavat-files

# Notes: nb, with the system's reminders and quick note
kavat-notes

# The system's settings, as a panel of the shell
kavat-settings

# The editor: Neovim, with the system's shortcuts and plugins
kavat-nvim

# Compressed files, which the file manager opens as folders; NTFS disks; headsets
7zip
ntfs-3g
headsetcontrol

# The installer. It takes itself out of the system it installs.
kavat-installer

# Fonts
inter-font
ttf-jetbrains-mono-nerd
noto-fonts
noto-fonts-emoji

# Virtual machines: tests/boot.py checks the running system through this agent
qemu-guest-agent
