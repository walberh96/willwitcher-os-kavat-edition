# Packages of the live system, one per line.

# Base and boot
base
kavat-base
kavat-boot
kavat-snapshots
# kav: the one command over pacman. The AUR is reached only through its reviewed list.
kav
linux-zen
linux-lts
linux-firmware
amd-ucode
intel-ucode
mkinitcpio
mkinitcpio-archiso
sudo
# the installer looks for systemd with which; without it, the boot image is not systemd's
which

# What the installed system boots and lives on
grub
efibootmgr
os-prober
btrfs-progs
dosfstools

# Network
networkmanager
iwd
wireless-regdb

# Loading screen of the installed system. Its look comes from kavat-theme.
plymouth

# Sound
pipewire
pipewire-pulse
wireplumber
rtkit

# Graphics: Mesa comes with Hyprland; this is the Vulkan driver of the target machine
vulkan-radeon

# Desktop: Hyprland as Arch ships it, and kavat-shell, the system's fork of Noctalia, with
# the configuration from [kavat].
# kavat-hyprland brings what its shortcuts open: Kitty, Yazi, hyprlock and the capture tools,
# and the theme system, kavat-theme, that gives all of them their look.
hyprland
kavat-shell
kavat-hyprland

# Login screen of the installed system: LightDM with the system's own greeter, which draws
# on an X server. The live session does not use it.
lightdm
kavat-greeter
xorg-server

# The installer. It takes itself out of the system it installs.
kavat-installer

# Fonts
inter-font
ttf-jetbrains-mono-nerd
noto-fonts
noto-fonts-emoji

# Virtual machines: tests/boot.py checks the running system through this agent
qemu-guest-agent
