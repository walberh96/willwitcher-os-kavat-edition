# the editor; what its picker looks with; git, for what changed; the clipboard; the
# language server for Markdown; and what makes the pictures of a note ready to be drawn
depends=('neovim' 'fzf' 'fd' 'ripgrep' 'bat' 'git' 'wl-clipboard' 'marksman' 'imagemagick')
# what builds the parsers
makedepends=('tree-sitter-cli' 'curl' 'tar')
options=('!debug' '!strip')

