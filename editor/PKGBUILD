for _plugin in "${_plugins[@]}"; do
  _repo=${_plugin% *} _commit=${_plugin#* }
  source+=("${_repo#*/}-$_commit.tar.gz::https://github.com/$_repo/archive/$_commit.tar.gz")
done
unset _plugin _repo _commit

# The parsers are compiled here, each from the revision nvim-treesitter names for it.
build() {
  local commit=${_plugins[6]#* }
  rm -rf "$srcdir/treesitter"
  HOME="$srcdir/home" nvim --headless -u NONE -l build-parsers.lua \
    "$srcdir/nvim-treesitter-$commit" parsers.txt "$srcdir/treesitter"
}

package() {
  local plugin repo commit name
  install -d "$pkgdir/usr/share/kavat/nvim/plugins"
  for plugin in "${_plugins[@]}"; do
    repo=${plugin% *} commit=${plugin#* } name=${repo#*/}
    cp -r "$srcdir/$name-$commit" "$pkgdir/usr/share/kavat/nvim/plugins/$name"
  done
  cp -r "$srcdir/treesitter" "$pkgdir/usr/share/kavat/nvim/treesitter"

  # Neovim looks in this folder by itself, so require("kavat") and the colour scheme are
  # found without the user's configuration naming a path
  install -d "$pkgdir/usr/share/nvim/site"
  cp -r "$startdir/lua" "$startdir/colors" "$pkgdir/usr/share/nvim/site/"
  install -Dm644 init.lua "$pkgdir/etc/skel/.config/nvim/init.lua"
  chmod -R u=rwX,go=rX "$pkgdir/usr/share"
}
